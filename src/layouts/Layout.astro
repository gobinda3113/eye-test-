---
import "../styles/global.css";
import "../styles/extra.css";
import {
  LOCALES,
  DEFAULT_LOCALE,
  pageDef,
  urlFor,
  alternates,
  ogImage,
  ogLocale,
} from "../lib/site.ts";
import { seoFor } from "../data/seo.ts";
import { DICT } from "../scripts/dict.ts";

const { locale = DEFAULT_LOCALE, page = "home", noindex = false, customMeta, customAlts, customXDefault, schema } = Astro.props;
const def = pageDef(page);
const baseMeta = seoFor(locale, page);
const meta = customMeta ? { ...baseMeta, ...customMeta } : baseMeta;
const isPrivacyNonCluster = page === "privacy" && !["en", "it", "ru"].includes(locale);
const canonical = customMeta?.url || urlFor(locale, page);
const alts = customAlts !== undefined
  ? customAlts
  : isPrivacyNonCluster
    ? []
    : canonical === urlFor(locale, page)
      ? alternates(page, locale)
      : [{ hreflang: locale, url: canonical }];
const xDefaultUrl = customXDefault !== undefined
  ? customXDefault
  : isPrivacyNonCluster
    ? null
    : canonical === urlFor(locale, page)
      ? urlFor(DEFAULT_LOCALE, page)
      : canonical;
const isError = Boolean(noindex || def.noindex);
const robots = isError ? "noindex, follow" : "index, follow";
const og = ogImage(locale);

const fontHref = "/fonts/fonts.css";
---

<!doctype html>
<html lang={locale} dir="ltr" data-theme="light">
    <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      var initStorage = 'denied';
      try {
        if (localStorage.getItem('dmv-eye-test.consent') === 'granted') {
          initStorage = 'granted';
        }
      } catch (e) {}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        analytics_storage: initStorage,
        ad_user_data: 'denied',
        ad_personalization: 'denied'
      });
      gtag('js', new Date());
      gtag('config', 'G-55QRZ61B47');

      function loadGtag() {
        if (document.getElementById('gtag-js')) return;
        var s = document.createElement('script');
        s.id = 'gtag-js';
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-55QRZ61B47';
        document.head.appendChild(s);
      }
      window.__loadGtag = loadGtag;
      if (initStorage === 'granted') {
        loadGtag();
      }
    </script>
    <meta charset="utf-8" />
    <meta name="yandex-verification" content="b13d3f1622cfc654" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="robots" content={robots} />
    <script is:inline>
      if (typeof window !== 'undefined' && window.location.hostname && window.location.hostname !== 'onlinevisiontest.org' && window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1') {
        var rMeta = document.querySelector('meta[name="robots"]');
        if (rMeta) rMeta.setAttribute('content', 'noindex, nofollow');
      }
    </script>
    <meta name="theme-color" content="#FBFAF7" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />

    {
      alts && alts.map((a) => (
        <link rel="alternate" hreflang={a.hreflang} href={a.url} />
      ))
    }
    {xDefaultUrl && <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />}

    <meta property="og:type" content={page.startsWith("blog") ? "article" : "website"} />
    <meta property="og:site_name" content="Online Vision Test" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={meta.title} />
    <meta property="og:locale" content={ogLocale(locale)} />
    {
      LOCALES.filter((l) => l !== locale).map((l) => (
        <meta property="og:locale:alternate" content={ogLocale(l)} />
      ))
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content={meta.title} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    {
      schema && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
      )
    }



    <link rel="stylesheet" href={fontHref} />

    <slot name="structured-data" />


    <script is:inline set:html={`window._dict=${JSON.stringify(DICT[locale] || DICT.en)};`} />

    <script is:inline>
      // Runs before first paint: applies the stored theme (no light/dark flash)
      // and, on a non-English route, pins the language so the client-side
      // i18n.js dictionary hydrates in the same language the page was built in.
      try {
        var storedTheme = localStorage.getItem("dmv-eye-test.theme");
        var prefersDark =
          window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = storedTheme || (prefersDark ? "dark" : "light");
        var routeLang = document.documentElement.lang || "en";
        if (routeLang !== "en") localStorage.setItem("dmv-eye-test.lang", routeLang);
      } catch (err) {}
    </script>

    <script is:inline>
      // Progressive accessibility layer. The wizard already ships arrow-key and
      // Enter/Space handling in lab.js; this only labels what the script cannot
      // know about statically (live region, step changes, canvases) and is
      // deliberately tiny so it never delays the lab.
      (function () {
        function labelCanvases() {
          var c = document.querySelectorAll("canvas:not([aria-label])");
          for (var i = 0; i < c.length; i++) {
            c[i].setAttribute("role", "img");
            c[i].setAttribute("aria-label", "Vision test image");
          }
        }
        // The depth-perception step is answered with buttons, so give the answer
        // group a keyboard route of its own: 1-4 pick a shape in order, N answers
        // "cannot see a shape", Y moves focus to the answers. Pure synthetic
        // clicks — the wizard's own state machine is untouched.
        function labelStereo() {
          var wrap = document.querySelector(".stereo-btns");
          if (!wrap) return;
          var btns = wrap.querySelectorAll("button[data-shape]");
          var n = 0;
          for (var i = 0; i < btns.length; i++) {
            var shape = btns[i].getAttribute("data-shape");
            if (shape === "none") btns[i].setAttribute("aria-keyshortcuts", "N");
            else {
              n++;
              btns[i].setAttribute("aria-keyshortcuts", String(n));
            }
          }
        }
        function stereoKeys(e) {
          if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.altKey) return;
          var t = e.target;
          if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.tagName === "SELECT" || t.isContentEditable)) return;
          var wrap = document.querySelector(".stereo-btns");
          if (!wrap) return;
          var key = (e.key || "").toLowerCase();
          var shapes = wrap.querySelectorAll('button[data-shape]:not([data-shape="none"])');
          var none = wrap.querySelector('button[data-shape="none"]');
          if (key === "y") {
            e.preventDefault();
            if (shapes[0]) shapes[0].focus();
            return;
          }
          if (key === "n" || key === "0") {
            if (!none) return;
            e.preventDefault();
            none.click();
            return;
          }
          if (key >= "1" && key <= "9") {
            var idx = Number(key) - 1;
            if (!shapes[idx]) return;
            e.preventDefault();
            shapes[idx].click();
          }
        }
        function announce() {
          var s = document.getElementById("labStatus");
          if (s && !s.getAttribute("aria-live")) s.setAttribute("aria-live", "polite");
          var st = document.getElementById("labStage");
          if (st && !st.getAttribute("role")) {
            st.setAttribute("role", "region");
            st.setAttribute("aria-label", "Vision test step");
            st.setAttribute("tabindex", "-1");
          }
          var last = st && st.firstElementChild;
          if (st && last && st.dataset.a11yStep !== String(st.childElementCount)) {
            st.dataset.a11yStep = String(st.childElementCount);
            try {
              st.focus({ preventScroll: true });
            } catch (err) {}
          }
          labelCanvases();
          labelStereo();
        }
        function start() {
          var st = document.getElementById("labStage");
          announce();
          if (st && window.MutationObserver) new MutationObserver(announce).observe(st, { childList: true, subtree: true });
          else if (st) setInterval(announce, 800);
          document.addEventListener("keydown", stereoKeys);
        }
        if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", start);
        else start();
      })();
    </script>
  </head>
  <body class={page === "home" ? undefined : "is-doc"}>
    <slot />

    <!-- Non-blocking consent banner -->
    <aside id="cookieConsentBanner" class="consent-banner" aria-label={(DICT[locale] || DICT.en)["consent.ariaLabel"] || "Cookie and analytics consent"} style="display:none;">
      <div class="consent-banner-inner">
        <p class="consent-banner-text">
          {(DICT[locale] || DICT.en)["consent.banner"]}
          <a href={locale === "en" ? "/privacy/" : `/${locale}/privacy/`} class="consent-policy-link">
            {(DICT[locale] || DICT.en)["footer.privacy"] || "Privacy"}
          </a>
        </p>
        <div class="consent-banner-actions">
          <button type="button" id="consentDeclineBtn" class="btn btn-sm btn-quiet">
            {(DICT[locale] || DICT.en)["consent.decline"]}
          </button>
          <button type="button" id="consentAcceptBtn" class="btn btn-sm btn-primary">
            {(DICT[locale] || DICT.en)["consent.accept"]}
          </button>
        </div>
      </div>
    </aside>

    <script is:inline>
      (function() {
        var banner = document.getElementById("cookieConsentBanner");
        var acceptBtn = document.getElementById("consentAcceptBtn");
        var declineBtn = document.getElementById("consentDeclineBtn");
        var consent = null;
        try { consent = localStorage.getItem("dmv-eye-test.consent"); } catch(e){}

        if (consent === "granted") {
          if (typeof gtag === "function") {
            gtag("consent", "update", { analytics_storage: "granted" });
          }
          if (typeof window.__loadGtag === "function") {
            window.__loadGtag();
          }
        } else if (!consent) {
          if (banner) banner.style.display = "block";
        }

        if (acceptBtn) {
          acceptBtn.addEventListener("click", function() {
            try { localStorage.setItem("dmv-eye-test.consent", "granted"); } catch(e){}
            if (typeof gtag === "function") {
              gtag("consent", "update", { analytics_storage: "granted" });
            }
            if (typeof window.__loadGtag === "function") {
              window.__loadGtag();
            }
            if (banner) banner.style.display = "none";
          });
        }
        if (declineBtn) {
          declineBtn.addEventListener("click", function() {
            try { localStorage.setItem("dmv-eye-test.consent", "denied"); } catch(e){}
            if (typeof gtag === "function") {
              gtag("consent", "update", { analytics_storage: "denied" });
            }
            if (banner) banner.style.display = "none";
          });
        }
      })();
    </script>
</body>
</html>
