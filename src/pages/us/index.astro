---
import Layout from "../../layouts/Layout.astro";
import HomePage from "../../components/HomePage.astro";
import { SITE, usAlternates, usUrl } from "../../lib/site.ts";
import { seoFor } from "../../data/seo.ts";

export const prerender = true;

const meta = seoFor("en", "us");
const customMeta = {
  title: meta.title,
  description: meta.description,
  keywords: meta.keywords,
  url: usUrl(),
};
const customAlts = usAlternates();
---

<Layout locale="en" page="us" customMeta={customMeta} customAlts={customAlts} customXDefault={SITE + "/"}>
  <HomePage locale="en" variant="us" />
</Layout>
