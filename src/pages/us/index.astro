---
import Layout from "../../layouts/Layout.astro";
import HomePage from "../../components/HomePage.astro";
import SiteShell from "../../components/SiteShell.astro";
import { SITE, usAlternates, usUrl } from "../../lib/site.ts";
import { seoFor } from "../../data/seo.ts";
import { STATES_VERIFIED as STATES } from "../../data/states.ts";

export const prerender = true;

const meta = seoFor("en", "us");
const customMeta = {
  title: meta.title,
  description: meta.description,
  keywords: meta.keywords,
  url: usUrl(),
};
const customAlts = usAlternates();

const sortedStates = [...STATES].sort((a, b) => a.name.localeCompare(b.name));
---

<Layout locale="en" page="us" customMeta={customMeta} customAlts={customAlts} customXDefault={usUrl()}>
  <HomePage locale="en" variant="us" />
  <SiteShell locale="en" page="home">
    <div class="container section" style="padding-top: 0;">
      <div style="margin-bottom: 48px;">
        <h2 style="font-size: 22px; margin-bottom: 8px;">DMV Eye Test Requirements — All 51 Jurisdictions</h2>
        <p style="color: var(--muted); font-size: 14px; margin-bottom: 20px;">Select your state for specific vision standards, the doctor referral form name, field-of-vision thresholds, and renewal schedules.</p>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 12px;">
          {sortedStates.map((s) => {
            const slug = s.name.toLowerCase().replace(/ /g, "-");
            return (
              <a
                href={`/states/${slug}/`}
                style="display: flex; flex-direction: column; justify-content: space-between; padding: 16px 18px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-sm); text-decoration: none; color: inherit; transition: border-color 0.15s, background 0.15s;"
                onmouseover="this.style.background='var(--surface-2)'; this.style.borderColor='var(--border-strong)'"
                onmouseout="this.style.background='var(--surface)'; this.style.borderColor='var(--border)'"
              >
                <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 8px;">
                  <strong style="font-size: 15px; color: var(--text);">{s.name}</strong>
                  <span style="font-family: var(--font-mono); font-size: 11px; font-weight: 600; color: var(--muted); background: var(--surface-2); border: 1px solid var(--border); padding: 2px 5px; border-radius: var(--r-xs);">{s.code}</span>
                </div>
                <div style="font-size: 12px; color: var(--muted); margin-top: 8px;">
                  Min acuity: <strong style="color: var(--text); font-family: var(--font-display); font-size: 14px;">{s.min}</strong>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </SiteShell>
</Layout>
