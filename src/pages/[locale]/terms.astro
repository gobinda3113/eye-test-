---
import Layout from "../../layouts/Layout.astro";
import SiteShell from "../../components/SiteShell.astro";
import ProsePage from "../../components/ProsePage.astro";
import { LOCALES, DEFAULT_LOCALE } from "../../lib/site.ts";

export const prerender = true;

export function getStaticPaths() {
  return LOCALES.filter((locale) => locale !== DEFAULT_LOCALE).map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params;
const isEnglishBody = ["es", "fr", "de", "pt", "ja"].includes(locale as string);
---

<Layout locale={locale} page="terms" noindex={isEnglishBody}>
  <SiteShell locale={locale} page="terms">
    <ProsePage locale={locale} page="terms" />
  </SiteShell>
</Layout>
