---
import Layout from "../../layouts/Layout.astro";
import SiteShell from "../../components/SiteShell.astro";
import ProsePage from "../../components/ProsePage.astro";
import { LOCALES, DEFAULT_LOCALE, HREFLANG, urlFor } from "../../lib/site.ts";

export const prerender = true;

export function getStaticPaths() {
  return LOCALES.filter((locale) => locale !== DEFAULT_LOCALE).map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params;
const selfUrl = urlFor(locale, "contact");
const customAlts = [{ locale, hreflang: HREFLANG[locale], url: selfUrl }];
---

<Layout locale={locale} page="contact" noindex={true} customAlts={customAlts} customXDefault={null}>
  <SiteShell locale={locale} page="contact">
    <ProsePage locale={locale} page="contact" />
  </SiteShell>
</Layout>
