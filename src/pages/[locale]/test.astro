---
import Layout from "../../layouts/Layout.astro";
import TestPage from "../../components/TestPage.astro";
import { LOCALES, DEFAULT_LOCALE } from "../../lib/site.ts";

export const prerender = true;

export function getStaticPaths() {
  return LOCALES.filter((locale) => locale !== DEFAULT_LOCALE).map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params;
---

<Layout locale={locale} page="test" noindex={true}>
  <TestPage locale={locale} />
</Layout>
