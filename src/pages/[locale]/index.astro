---
import Layout from "../../layouts/Layout.astro";
import HomePage from "../../components/HomePage.astro";
import { LOCALES, DEFAULT_LOCALE, SITE, homeAlternates } from "../../lib/site.ts";

export const prerender = true;

export function getStaticPaths() {
  return LOCALES.filter((locale) => locale !== DEFAULT_LOCALE).map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params;
const customAlts = homeAlternates();
---

<Layout locale={locale} page="home" customAlts={customAlts} customXDefault={SITE + "/"}>
  <HomePage locale={locale} variant="generic" />
</Layout>
