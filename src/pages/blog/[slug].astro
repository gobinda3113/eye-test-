---
import { POSTS } from "../../data/blog.ts";
import Layout from "../../layouts/Layout.astro";
import SiteShell from "../../components/SiteShell.astro";
import BlogPost from "../../components/BlogPost.astro";
import { LOCALES, HREFLANG, SITE } from "../../lib/site.ts";

export const prerender = true;

export function getStaticPaths() {
  return POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const customMeta = {
  title: post.title.en,
  description: post.excerpt.en,
  url: SITE + "/blog/" + post.slug + "/",
};

const customAlts = LOCALES.filter(l => !post.englishOnly || l === "en").map(l => ({
  locale: l,
  hreflang: HREFLANG[l],
  url: SITE + (l === "en" ? "" : "/" + l) + "/blog/" + post.slug + "/",
}));

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.title.en,
  "description": post.excerpt.en,
  "url": "https://onlinevisiontest.org/blog/" + post.slug + "/",
  "mainEntityOfPage": SITE + "/blog/" + post.slug + "/",
  "inLanguage": "en",
  "image": SITE + "/og-en.png",
  "author": { "@type": "Organization", name: "Online Vision Test", url: SITE + "/" },
  "datePublished": post.datePublished || "2025-06-01T08:00:00Z",
  "dateModified": post.dateModified || "2026-09-20T08:00:00Z",
  "publisher": {
    "@type": "Organization",
    name: "Online Vision Test",
    url: SITE + "/",
    logo: { "@type": "ImageObject", url: SITE + "/favicon.svg" }
  },
};
---

<Layout locale="en" page="blog" schema={schema} customMeta={customMeta} customAlts={customAlts} customXDefault={SITE + "/blog/" + post.slug + "/"}>
  <SiteShell locale="en" page="blog" customAlts={customAlts}>
    <BlogPost locale="en" post={post} />
  </SiteShell>
</Layout>
