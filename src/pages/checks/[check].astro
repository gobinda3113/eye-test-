---
import Layout from "../../layouts/Layout.astro";
import SiteShell from "../../components/SiteShell.astro";
import { CHECKS } from "../../scripts/data.ts";
import { CHECKS_CONTENT } from "../../data/checksContent.ts";
import { DICT } from "../../scripts/dict.ts";

export const prerender = true;

export function getStaticPaths() {
  return CHECKS.map((c) => ({
    params: { check: c.id },
    props: { check: c },
  }));
}

const { check } = Astro.props;
const guide = CHECKS_CONTENT[check.id] || {
  id: check.id,
  name: check.id,
  subtitle: "Visual screening check.",
  whatItMeasures: "Evaluates visual function.",
  opticalPrinciples: "Based on optical science.",
  testingProcedure: "Calibrate your screen and follow instructions.",
  clinicalBenchmarks: "Standard benchmarks apply.",
  whenToSeeDoctor: "Consult an optometrist if you notice symptoms.",
};

const title = `${guide.name}: Clinical Guide & Online Screening`;
const description = guide.subtitle;
const canonical = `https://onlinevisiontest.org/checks/${check.id}/`;

const schema = {
  "@context": "https://schema.org",
  "@type": ["WebPage", "MedicalWebPage"],
  "name": title,
  "headline": guide.name,
  "description": description,
  "url": canonical,
  "inLanguage": "en",
  "publisher": {
    "@type": "Organization",
    "name": "Online Vision Test",
    "url": "https://onlinevisiontest.org/"
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Online Vision Test",
        "item": "https://onlinevisiontest.org/",
        "id": "https://onlinevisiontest.org/",
        "@id": "https://onlinevisiontest.org/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Checks",
        "item": "https://onlinevisiontest.org/checks/",
        "id": "https://onlinevisiontest.org/checks/",
        "@id": "https://onlinevisiontest.org/checks/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": guide.name,
        "item": canonical,
        "id": canonical,
        "@id": canonical
      }
    ]
  }
};
---

<Layout locale="en" customMeta={{ title, description, url: canonical }} schema={schema}>
  <SiteShell locale="en" page="checks">
    <div class="container section">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Online Vision Test</a></li>
          <li><a href="/checks/">Checks</a></li>
          <li aria-current="page">{guide.name}</li>
        </ol>
      </nav>

      <div class="simple-hero">
        <div class="eyebrow">Clinical Guide</div>
        <h1>{guide.name}</h1>
        <p>{guide.subtitle}</p>
        <p style="margin-top: 20px;">
          <a class="btn btn-primary" href={`/test/?mode=individual&check=${check.id}`}>
            Launch Interactive {guide.name}
          </a>
        </p>
      </div>

      <div class="snellen-divider" aria-hidden="true" style="margin: 24px 0 36px;">
        <span class="snellen-motif">
          <span class="m-1">E</span>
          <span class="m-2">F P</span>
          <span class="m-3">T O Z</span>
          <span class="m-4">L P E D</span>
        </span>
      </div>

      <div class="prose" style="max-width: 74ch; margin: 0 auto;">
        <h2>What this check evaluates</h2>
        <p>{guide.whatItMeasures}</p>

        <h2>Optical principles and visual mechanisms</h2>
        <p>{guide.opticalPrinciples}</p>

        <h2>Standard testing procedure at home</h2>
        <p>{guide.testingProcedure}</p>

        <h2>Clinical standards and passing benchmarks</h2>
        <p>{guide.clinicalBenchmarks}</p>

        <h2>When to schedule an in-person eye exam</h2>
        <p>{guide.whenToSeeDoctor}</p>

        <div style="background: var(--surface); border: 1px solid var(--border); padding: 1.5rem; border-radius: var(--r-sm); margin: 3rem 0 2rem;">
          <h3 style="margin-top: 0; font-size: 1.1rem; font-weight: 600;">Practice Screener Notice</h3>
          <p style="color: var(--muted); font-size: 0.95rem; margin-bottom: 0; line-height: 1.6;">
            This browser-based check is an educational self-screening and rehearsal tool. It cannot replace a comprehensive medical examination, dilation, or intraocular pressure measurement by an optometrist or ophthalmologist. If you experience visual pain, floaters, flashes, or persistent blur, see an eye care professional.
          </p>
        </div>

        <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 2rem;">
          <a class="btn btn-primary" href={`/test/?mode=individual&check=${check.id}`}>
            Start {guide.name}
          </a>
          <a class="btn btn-ghost" href="/checks/">
            Browse all 13 checks
          </a>
        </div>
      </div>
    </div>
  </SiteShell>
</Layout>
