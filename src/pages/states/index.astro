---
import Layout from "../../layouts/Layout.astro";
import SiteShell from "../../components/SiteShell.astro";
import { STATES_VERIFIED as STATES } from "../../data/states.ts";
import { SITE } from "../../lib/site.ts";

export const prerender = true;

const title = "DMV Eye Test by State — Vision Requirements in All 50 States";
const description = "Find DMV eye test requirements, minimum visual acuity standards, and renewal vision rules for all 50 US states and DC. Practice the test online.";
const canonical = `${SITE}/states/`;

const customMeta = {
  title,
  description,
  url: canonical,
};

const customAlts = [{ hreflang: "en", url: canonical }];
const customXDefault = canonical;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "url": "https://onlinevisiontest.org/states/",
  "inLanguage": "en",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Online Vision Test",
        "item": "https://onlinevisiontest.org/",
        "id": "https://onlinevisiontest.org/",
        "@id": "https://onlinevisiontest.org/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "DMV Practice",
        "item": "https://onlinevisiontest.org/us/",
        "id": "https://onlinevisiontest.org/us/",
        "@id": "https://onlinevisiontest.org/us/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "States",
        "item": "https://onlinevisiontest.org/states/",
        "id": "https://onlinevisiontest.org/states/",
        "@id": "https://onlinevisiontest.org/states/"
      }
    ]
  },
  "mainEntity": {
    "@type": "ItemList",
    "name": "DMV Eye Test Requirements by State",
    "itemListElement": STATES.map((s, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": `${s.name} DMV Eye Test`,
      "url": `https://onlinevisiontest.org/states/${s.name.toLowerCase().replace(/ /g, "-")}/`
    }))
  }
};

const sortedStates = [...STATES].sort((a, b) => a.name.localeCompare(b.name));
---

<Layout locale="en" customMeta={customMeta} customAlts={customAlts} customXDefault={customXDefault} schema={jsonLd}>
  <SiteShell locale="en" page="home">
    <div class="container section">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Online Vision Test</a></li>
          <li><a href="/us/">DMV Practice</a></li>
          <li aria-current="page">States</li>
        </ol>
      </nav>

      <div class="simple-hero">
        <div class="eyebrow">State Index</div>
        <h1>DMV Eye Test Requirements by State</h1>
        <p>
          Every US state sets its own vision standards for obtaining or renewing a driver's license. While most states require <strong>20/40 visual acuity</strong> for an unrestricted license, renewal schedules, restricted license thresholds, and field of vision requirements vary nationwide. Select your state below to review specific requirements and practice the test online.
        </p>
        <p style="margin-top: 20px;">
          <a class="btn btn-primary" href="/us/">Practice the US DMV Eye Test</a>
        </p>
      </div>

      <div style="margin-top: 36px;">
        <h2 style="font-size: 22px; margin-bottom: 16px;">All 50 States and DC</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 14px;">
          {sortedStates.map((s) => {
            const slug = s.name.toLowerCase().replace(/ /g, "-");
            return (
              <a
                href={`/states/${slug}/`}
                style="display: flex; flex-direction: column; justify-content: space-between; padding: 18px 20px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-sm); text-decoration: none; color: inherit; transition: border-color 0.15s, background 0.15s;"
                onmouseover="this.style.background='var(--surface-2)'; this.style.borderColor='var(--border-strong)'"
                onmouseout="this.style.background='var(--surface)'; this.style.borderColor='var(--border)'"
              >
                <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 8px;">
                  <strong style="font-size: 16px; color: var(--text);">{s.name}</strong>
                  <span style="font-family: var(--font-mono); font-size: 11px; font-weight: 600; color: var(--muted); background: var(--surface-2); border: 1px solid var(--border); padding: 2px 6px; border-radius: var(--r-xs);">{s.code}</span>
                </div>
                <div style="font-size: 13px; color: var(--muted); margin-top: 10px;">
                  Min Acuity: <strong style="color: var(--text); font-family: var(--font-display); font-size: 15px;">{s.min}</strong> ({s.need === "both" ? "both eyes" : "better eye"})
                </div>
              </a>
            );
          })}
        </div>
      </div>

      <div class="snellen-divider" aria-hidden="true" style="margin: 40px 0;">
        <span class="snellen-motif">
          <span class="m-1">E</span>
          <span class="m-2">F P</span>
          <span class="m-3">T O Z</span>
          <span class="m-4">L P E D</span>
        </span>
      </div>

      <div class="prose" style="max-width: 72ch;">
        <h2>Common Questions About State DMV Vision Tests</h2>
        <h3>What if my vision is worse than 20/40?</h3>
        <p>
          Most states allow you to obtain a restricted license (such as daylight-only driving or wearing corrective lenses) if your corrected vision is between 20/40 and 20/70. If you cannot meet your state's minimum standard at the counter, you will typically receive a state vision examination form to have completed by a licensed optometrist or ophthalmologist.
        </p>
        <h3>How to prepare before visiting the DMV</h3>
        <p>
          You can test your visual acuity at home using our <a href="/eye-test-chart/">Snellen eye test chart</a> or take the full <a href="/us/">DMV practice screening</a> to check your distance acuity, color vision, and peripheral vision.
        </p>
      </div>
    </div>
  </SiteShell>
</Layout>
