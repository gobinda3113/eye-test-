---
import { STATES_VERIFIED as STATES } from "../../data/states.ts";
import Layout from "../../layouts/Layout.astro";
import SiteShell from "../../components/SiteShell.astro";
import { SITE } from "../../lib/site.ts";

export const prerender = true;

export function getStaticPaths() {
  return STATES.map((state) => ({
    params: { state: state.name.toLowerCase().replace(/ /g, "-") },
    props: { stateData: state },
  }));
}

const { stateData } = Astro.props;
const slug = stateData.name.toLowerCase().replace(/ /g, "-");

const customMeta = {
  title: `DMV Eye Test Online ${stateData.name} - Free Practice Screening`,
  description: `Practice the ${stateData.name} DMV eye test online before you go. Minimum acuity required for ${"AEIOUaeiou".includes(stateData.name[0]) && stateData.name.toLowerCase() !== "utah" ? "an" : "a"} ${stateData.name} driver's license: ${stateData.min}.`,
  url: `${SITE}/states/${slug}/`,
};

const customAlts = [{ hreflang: "en", url: customMeta.url }];
const customXDefault = customMeta.url;

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": `${stateData.name} DMV Eye Test & Vision Requirements`,
  "url": `https://onlinevisiontest.org/states/${slug}/`,
  "description": `Pass the ${stateData.name} DMV eye test in ${new Date().getFullYear()}. Learn the vision requirements, visual acuity minimums, and practice online.`,
  "inLanguage": "en",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Online Vision Test",
        "item": "https://onlinevisiontest.org/",
        "id": "https://onlinevisiontest.org/",
        "@id": "https://onlinevisiontest.org/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "States",
        "item": "https://onlinevisiontest.org/states/",
        "id": "https://onlinevisiontest.org/states/",
        "@id": "https://onlinevisiontest.org/states/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": stateData.name,
        "item": `https://onlinevisiontest.org/states/${slug}/`,
        "id": `https://onlinevisiontest.org/states/${slug}/`,
        "@id": `https://onlinevisiontest.org/states/${slug}/`
      }
    ]
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `What is the standard vision requirement for a ${stateData.name} driver's license?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The standard vision requirement for a ${stateData.name} driver's license is ${stateData.min} in ${stateData.need === "both" ? "both eyes" : "at least one eye"}.`
      }
    },
    {
      "@type": "Question",
      "name": `Can I get a restricted license in ${stateData.name} if my vision is below the minimum?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": stateData.restrict ? `Yes, a restricted license may be possible with vision down to ${stateData.restrict}.` : "No, restricted licenses are not generally permitted below the minimum standard in this state."
      }
    },
    {
      "@type": "Question",
      "name": `How often is the vision test required in ${stateData.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The vision test is required ${stateData.renewal === "every" ? "every renewal cycle" : stateData.renewal === "alternate" ? "every other renewal cycle" : "depending on age or longer renewal cycles"}.`
      }
    }
  ]
};
---

<Layout locale="en" noindex={false} customMeta={customMeta} customAlts={customAlts} customXDefault={customXDefault} schema={pageSchema}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  <SiteShell locale="en" page="home">
    <div class="container section">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Online Vision Test</a></li>
          <li><a href="/states/">States</a></li>
          <li aria-current="page">{stateData.name}</li>
        </ol>
      </nav>

      <div class="simple-hero">
        <div class="eyebrow">State Requirements</div>
        <h1>DMV Eye Test Online: {stateData.name}</h1>
        <p>Preparing for your <strong>{stateData.name}</strong> driver's license renewal? The minimum visual acuity requirement in {stateData.name} is {stateData.min} in {stateData.need === "both" ? "both eyes" : "at least one eye"}.</p>
        <p style="margin-top: 20px;">
          <a class="btn btn-primary" href="/us/#screener">Practice the US DMV Test Online</a>
        </p>
      </div>

      <div class="prose" style="max-width: 72ch;">
        <h2>Vision Requirements for {stateData.name}</h2>
        <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-sm); padding: 20px 24px; margin: 16px 0 24px;">
          <ul style="margin: 0; padding-left: 0; list-style: none; display: grid; gap: 10px;">
            <li style="display: flex; justify-content: space-between; padding-bottom: 8px; border-bottom: 1px solid var(--border);">
              <span>Standard Acuity Requirement:</span>
              <strong style="font-family: var(--font-display); font-size: 17px; color: var(--text);">{stateData.min} ({stateData.need === "both" ? "both eyes" : "better eye"})</strong>
            </li>
            <li style="display: flex; justify-content: space-between; padding-bottom: 8px; border-bottom: 1px solid var(--border);">
              <span>Restricted License Minimum:</span>
              <strong>{stateData.restrict ? `Possible down to ${stateData.restrict}` : "Not generally permitted below minimum"}</strong>
            </li>
            <li style="display: flex; justify-content: space-between; padding-bottom: 8px; border-bottom: 1px solid var(--border);">
              <span>Renewal Testing Schedule:</span>
              <span>{stateData.renewal === "every" ? "Every renewal cycle" : stateData.renewal === "alternate" ? "Every other renewal cycle" : "Depending on age or longer cycles"}</span>
            </li>
            {stateData.field && (
              <li style="display: flex; justify-content: space-between; padding-bottom: 8px; border-bottom: 1px solid var(--border);">
                <span>Field of Vision:</span>
                <strong style="text-align: right; max-width: 60%;">{stateData.field}</strong>
              </li>
            )}
            {stateData.statute && (
              <li style="display: flex; justify-content: space-between; padding-bottom: 8px; border-bottom: 1px solid var(--border);">
                <span>Governing Rule or Statute:</span>
                <span style="font-family: var(--font-mono); font-size: 12px; text-align: right; max-width: 60%;">{stateData.statute}</span>
              </li>
            )}
            {stateData.doctorForm && (
              <li style="display: flex; justify-content: space-between;">
                <span>Doctor Referral Form:</span>
                <strong style="text-align: right; max-width: 60%;">{stateData.doctorForm}</strong>
              </li>
            )}
          </ul>
        </div>

        {stateData.retestPolicy && (
          <div style="background: var(--surface); border: 1px solid var(--border); border-left: 4px solid var(--brand, #0284c7); border-radius: var(--r-sm); padding: 18px 22px; margin: 20px 0;">
            <h3 style="font-size: 17px; margin: 0 0 8px 0; color: var(--text);">What Happens If You Fail the Counter Eye Test?</h3>
            <p style="margin: 0; font-size: 14px; line-height: 1.6; color: var(--text);">{stateData.retestPolicy}</p>
          </div>
        )}

        {stateData.dmvUrl && (
          <p style="margin: 16px 0; font-size: 14px; color: var(--muted);">
            Official agency reference: <a href={stateData.dmvUrl} target="_blank" rel="noopener noreferrer">Visit official {stateData.name} DMV licensing portal</a>.
            {stateData.asOf && <span> Verified against state administrative standards as of {stateData.asOf}.</span>}
          </p>
        )}

        {stateData.code === "CA" && (
          <div style="margin: 28px 0 0;">
            <h2>California-Specific DMV Vision Questions</h2>
            <h3>What is the California DMV two-eye vision standard?</h3>
            <p>California Vehicle Code § 12804.9 requires 20/40 visual acuity in both eyes together, and additionally 20/40 in at least one eye with a minimum of 20/70 in the other eye. If you meet the 20/40 combined standard but one eye falls below 20/40, the DMV evaluates your monocular performance separately. Failing the 20/40 combined standard triggers a 60-day temporary license during which you must return a completed DL-62 (Report of Vision Examination) from a licensed optometrist or ophthalmologist. The DMV may then require a supplemental driving performance test, particularly if your left eye falls below the minimum — because the left eye is the driver-side eye in California traffic conditions.</p>
            <h3>What is California DMV Form DL-62 and when is it needed?</h3>
            <p>Form DL-62 (Report of Vision Examination) is the California-specific document your eye doctor completes when you fail the counter acuity screening. Your optometrist or ophthalmologist fills in your corrected and uncorrected acuity, peripheral field measurements, and any relevant pathology, then signs and returns it to you. You submit it to the DMV within 60 days. Based on the DL-62 findings, the DMV determines whether to issue your license with a corrective-lenses restriction (code B), a daylight-only restriction, or require a behind-the-wheel driving test. The form is available at any California DMV office or from the <a href="https://www.dmv.ca.gov/portal/driver-licenses-identification-cards/vision-requirements/" target="_blank" rel="noopener noreferrer">CA DMV vision requirements page</a>.</p>
          </div>
        )}

        <h2>Why Practice Online?</h2>
        <p>
          Failing the eye test at the counter can delay your license. By calibrating your screen and standing at the correct distance, you can simulate the exact visual acuity check you will face. Our free practice screener takes about 10 minutes and includes the Tumbling-E and color blindness checks frequently used by licensing offices.
        </p>

        <h2>Related States in the {stateData.region}</h2>
        <p>Vision requirements and DMV eye test standards for other states in the {stateData.region} region:</p>
        <ul>
          {STATES.filter((s) => s.region === stateData.region && s.code !== stateData.code).slice(0, 5).map((rs) => (
            <li>
              <a href={`/states/${rs.name.toLowerCase().replace(/ /g, "-")}/`}>
                {rs.name} DMV Eye Test (Minimum Acuity: {rs.min})
              </a>
            </li>
          ))}
        </ul>

        <div style="margin-top: 32px; padding: 20px 24px; background: var(--surface); border-radius: var(--r-sm); border: 1px solid var(--border);">
          <p style="margin: 0 0 8px 0;">Looking for other state requirements? <a href="/states/">Browse vision requirements in all 50 states</a>.</p>
          <p style="margin: 0;">Getting ready for your test? <a href="/us/">Practice the US DMV eye test online</a>.</p>
        </div>
      </div>
    </div>
  </SiteShell>
</Layout>
