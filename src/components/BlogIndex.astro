---
import { seoFor } from "../data/seo.ts";
import { pathFor, urlFor } from "../lib/site.ts";
import { POSTS } from "../data/blog.ts";
import { DICT } from "../scripts/i18n.ts";

const { locale = "en" } = Astro.props;
const meta = seoFor(locale, "blog");
const dict = DICT[locale] || DICT.en;
const d = (k) => (dict[k] != null ? dict[k] : DICT.en[k] != null ? DICT.en[k] : k);

const home = pathFor(locale, "home");

// Filter posts for this locale
const visiblePosts = POSTS.filter(post => {
  const supportedLocales = post.locales || (post.englishOnly ? ["en"] : Object.keys(post.title || {}));
  return supportedLocales.includes(locale);
});

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Online Vision Test", item: home },
    { "@type": "ListItem", position: 2, name: meta.h1, item: urlFor(locale, "blog") },
  ],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />

<style>
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.75rem;
    margin-top: 2rem;
  }
  .blog-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r);
    padding: 1.75rem;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s, border-color 0.15s;
    display: flex;
    flex-direction: column;
  }
  .blog-card:hover {
    background: var(--surface-2);
    border-color: var(--border-strong);
  }
  .blog-card h3 {
    margin: 0 0 0.75rem 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text);
    transition: color 0.15s;
  }
  .blog-card:hover h3 {
    color: var(--primary);
  }
  .blog-card p {
    color: var(--text-2);
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    flex-grow: 1;
  }
  .read-more {
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.15s, transform 0.15s;
  }
  .blog-card:hover .read-more {
    color: var(--primary);
    transform: translateX(3px);
  }
</style>

<section class="section">
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href={home}>Online Vision Test</a></li>
        <li aria-current="page">{meta.h1}</li>
      </ol>
    </nav>

    <div class="simple-hero">
      <div class="eyebrow">{d("blog.eyebrow")}</div>
      <h1>{meta.h1}</h1>
      <p>{meta.lede}</p>
    </div>

    <div class="blog-grid">
      {visiblePosts.map(post => (
        <a href={pathFor(locale, "blog") + post.slug + "/"} class="blog-card">
          <h3>{post.title[locale] || post.title.en}</h3>
          <p>{post.excerpt[locale] || post.excerpt.en}</p>
          <span class="read-more" aria-hidden="true">
            {d("blog.readGuide")}
            <svg class="ico" viewBox="0 0 24 24" style="width: 14px; height: 14px;"><path d="M5 12h13M12.5 6l6 6-6 6"/></svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
