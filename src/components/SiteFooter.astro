---
/**
 * Shared site footer used across all pages and all locales.
 * Design language and styling matches the landing page footer.
 */
import { DICT } from "../scripts/dict.ts";

interface Props {
  locale?: string;
  page?: string;
  variant?: string;
}

const { locale = "en", page = "home", variant = "generic" } = Astro.props;
const isHome = page === "home";
const isUS = variant === "us" || page === "us" || (Astro.url.pathname && Astro.url.pathname.startsWith("/us/"));

const dict = DICT[locale] || DICT.en;
const d = (k: string) => (dict[k] != null ? dict[k] : DICT.en[k] != null ? DICT.en[k] : k);

const homeHref = isUS ? "/us/" : locale === "en" ? "/" : "/" + locale + "/";
const testHref = isUS ? "/us/test/" : locale === "en" ? "/test/" : "/" + locale + "/test/";
const blogHref = locale === "en" ? "/blog/" : "/" + locale + "/blog/";
const aboutHref = locale === "en" ? "/about/" : "/" + locale + "/about/";
const contactHref = locale === "en" ? "/contact/" : "/" + locale + "/contact/";
const privacyHref = locale === "en" ? "/privacy/" : "/" + locale + "/privacy/";
const termsHref = locale === "en" ? "/terms/" : "/" + locale + "/terms/";

const FOOTER_LINKS: Record<string, { chart: string; us: string; states: string; blog: string }> = {
  en: { chart: "Eye Test Chart", us: "DMV Practice", states: "States", blog: "Blog" },
  es: { chart: "Tabla optométrica", us: "Práctica DMV", states: "Estados (EE. UU.)", blog: "Blog" },
  fr: { chart: "Tableau de Snellen", us: "Test DMV (USA)", states: "États (USA)", blog: "Blog" },
  de: { chart: "Sehtafel (Snellen)", us: "US-DMV-Übung", states: "US-Bundesstaaten", blog: "Blog" },
  pt: { chart: "Tabela de Snellen", us: "Prática DMV", states: "Estados (EUA)", blog: "Blog" },
  it: { chart: "Tabella di Snellen", us: "Pratica DMV", states: "Stati (USA)", blog: "Blog" },
  ja: { chart: "視力検査表", us: "米国DMV練習", states: "米国州別基準", blog: "ブログ" },
  ru: { chart: "Таблица проверки зрения", us: "Практика DMV", states: "Штаты США", blog: "Блог" }
};
const fl = FOOTER_LINKS[locale] || FOOTER_LINKS.en;
---

<footer class="site-footer page-pad">
  <div class="footer-top">
    <div class="footer-brand">
      <a class="brand wordmark dark-wordmark" href={isHome ? "#top" : homeHref}>
        <span class="brand-mark logo-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none">
            <path d="M2.5 16c3.4-6.2 8-9.3 13.5-9.3S26.1 9.8 29.5 16c-3.4 6.2-8 9.3-13.5 9.3S5.9 22.2 2.5 16Z" stroke="currentColor" stroke-width="2.1" stroke-linejoin="round"/>
            <circle cx="16" cy="16" r="4.6" fill="currentColor"/>
            <path d="M11.4 20.2 20.6 11.8" stroke="var(--brand-mark-slash, #f6f6f0)" stroke-width="1.5" stroke-linecap="round" opacity=".85"/>
          </svg>
        </span>
        <span class="brand-text">Online<span class="wordmark-light">Vision</span>Test<span class="wordmark-dot">.</span></span>
      </a>
      <p data-i18n="gen.footer.tagline">{d("gen.footer.tagline")}</p>
      <a class="footer-cta-link" href={testHref} data-i18n="nav.cta">{d("nav.cta")}</a>
    </div>

    <nav class="footer-col" aria-label={d("footer.c1")}>
      <h3 data-i18n="footer.c1">{d("footer.c1")}</h3>
      <a href={`${testHref}?mode=individual&check=distance`} data-i18n="checks.distance.name">{d("checks.distance.name")}</a>
      <a href={`${testHref}?mode=individual&check=tumbling`} data-i18n="checks.tumbling.name">{d("checks.tumbling.name")}</a>
      <a href={`${testHref}?mode=individual&check=color`} data-i18n="checks.color.name">{d("checks.color.name")}</a>
      <a href={`${testHref}?mode=individual&check=peripheral`} data-i18n="checks.peripheral.name">{d("checks.peripheral.name")}</a>
      <a href={`${testHref}?mode=individual&check=near`} data-i18n="checks.near.name">{d("checks.near.name")}</a>
      <a href={`${testHref}?mode=individual&check=contrast`} data-i18n="checks.contrast.name">{d("checks.contrast.name")}</a>
      <a href={`${testHref}?mode=individual&check=astigmatism`} data-i18n="checks.astigmatism.name">{d("checks.astigmatism.name")}</a>
      <a href={`${testHref}?mode=individual&check=refraction`} data-i18n="checks.refraction.name">{d("checks.refraction.name")}</a>
      <a href={`${testHref}?mode=individual&check=stereo`} data-i18n="checks.stereo.name">{d("checks.stereo.name")}</a>
      {isUS && <a href={`${testHref}?mode=individual&check=cdl`} data-i18n="checks.cdl.name">{d("checks.cdl.name")}</a>}
      <a href={`${testHref}?mode=individual&check=landolt`} data-i18n="checks.landolt.name">{d("checks.landolt.name")}</a>
      <a href={`${testHref}?mode=individual&check=amsler`} data-i18n="checks.amsler.name">{d("checks.amsler.name")}</a>
      <a href={`${testHref}?mode=individual&check=sivtsev`} data-i18n="checks.sivtsev.name">{d("checks.sivtsev.name")}</a>
    </nav>

    <nav class="footer-col" aria-label={d("footer.c2")}>
      <h3 data-i18n="footer.c2">{d("footer.c2")}</h3>
      <a href="/eye-test-chart/">{fl.chart}</a>
      <a href="/us/">{fl.us}</a>
      <a href="/states/">{fl.states}</a>
      <a href={blogHref} data-i18n="nav.blog">{fl.blog}</a>
      <a href={isHome ? "#faq" : `${homeHref}#faq`} data-i18n="footer.g4">{d("footer.g4")}</a>
      <a href={isHome ? "#reference" : `${homeHref}#reference`} data-i18n="refs.kicker">{d("refs.kicker")}</a>
    </nav>

    <nav class="footer-col" aria-label={d("footer.company")}>
      <h3 data-i18n="footer.company">{d("footer.company")}</h3>
      <a href={aboutHref} data-i18n="nav.about">{d("nav.about")}</a>
      <a href={contactHref} data-i18n="nav.contact">{d("nav.contact")}</a>
    </nav>

    <nav class="footer-col" aria-label={d("footer.legal")}>
      <h3 data-i18n="footer.legal">{d("footer.legal")}</h3>
      <a href={privacyHref} data-i18n="footer.privacy">{d("footer.privacy")}</a>
      <a href={termsHref} data-i18n="footer.terms">{d("footer.terms")}</a>
    </nav>
  </div>

  <div class="footer-bottom">
    <div class="disclaimer" role="note" aria-label="Medical and legal notice">
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5 21 19H3l9-15.5Z"/><path d="M12 10v4.2M12 16.6v.1"/></svg>
      <p data-i18n="footer.disclaimer">{d("footer.disclaimer")}</p>
    </div>
    <p class="copyright"><span id="year">2026</span> <span data-i18n="footer.copy">{d("footer.copy")}</span></p>
  </div>
</footer>

<script is:inline>
  (function () {
    var y = document.getElementById("year");
    if (y) y.textContent = String(new Date().getFullYear());
  })();
</script>
