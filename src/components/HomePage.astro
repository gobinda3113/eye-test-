---
/**
 * The single-page application, extracted from the generator's index.html.
 *
 * Structure, ids, classes and every data-i18n key are unchanged, so lab.ts,
 * app.ts and the eight-language switcher keep working exactly as before.
 *
 * Every data-i18n element, check card, reference card, and FAQ item is
 * server-rendered from the same src/scripts/i18n.ts dictionary the client
 * hydrates from, so every locale route ships 100% localized HTML with zero
 * untranslated English fallback text before JavaScript runs.
 */

import { DICT } from "../scripts/i18n.ts";
import {
  FAQ_COUNT,
  US_ONLY_FAQ_NUMS,
  CHECKS,
  US_ONLY_CHECK_IDS,
  ICONS,
  REFS,
  SOURCES,
  DMV_LINKS,
} from "../scripts/data.ts";
import { seoFor } from "../data/seo.ts";
import { SITE, LOCALES } from "../lib/site.ts";

const { locale = "en", variant = "generic" } = Astro.props;
// The US DMV practice screener lives only on /us/. Every homepage route (/,
// /es/, ...) renders the generic vision check, whatever the language.
const isUS = variant === "us";
// English generic homepage uses neutral gen.* keys (DMV wording stays on /us/).
// Other locales already render their own generic copy, so they are untouched.
const useGen = !isUS && locale === "en";
const K = (k) => (useGen ? "gen." + k : k);
// /us/ carries the exact main keyword in its H1; every other page keeps its own.
const heroTitleKey = isUS ? "us.hero.title" : K("hero.title");
const faqNums = Array.from({ length: FAQ_COUNT }, (_, i) => i + 1).filter(
  (n) => isUS || !US_ONLY_FAQ_NUMS.includes(n)
);
const checkList = isUS
  ? CHECKS
  : CHECKS.filter((c) => !US_ONLY_CHECK_IDS.includes(c.id));
const dict = DICT[locale] || DICT.en;
const d = (k) => (dict[k] != null ? dict[k] : DICT.en[k] != null ? DICT.en[k] : k);
const meta = seoFor(locale, isUS ? "us" : "home");
const blogHref = locale === "en" ? "/blog/" : "/" + locale + "/blog/";

const strip = (s) => String(s).replace(/<[^>]+>/g, " ").replace(/&nbsp;/g, " ").replace(/\s+/g, " ").trim();

const appSchema = {
  "@context": "https://schema.org",
  "@type": ["WebApplication", "HealthApplication", "MedicalWebPage"],
  name: "Online Vision Test",
  url: isUS ? SITE + "/us/" : SITE + "/",
  applicationCategory: "HealthApplication",
  operatingSystem: "Any modern web browser",
  browserRequirements: "Requires JavaScript and a calibrated display.",
  inLanguage: LOCALES,
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description: meta.description,
  publisher: { "@type": "Organization", name: "Online Vision Test", url: SITE + "/" },
};

const testSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalTest",
  name: isUS ? "DMV Practice Eye Test" : "Online Vision Screening Test",
  usesDevice: "Computer monitor or smartphone screen",
  purpose: "Screening simulation for visual acuity",
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: locale,
  mainEntity: faqNums.map((n) => ({
    "@type": "Question",
    name: strip(d("faq.q" + n)),
    acceptedAnswer: { "@type": "Answer", text: strip(d("faq.a" + n)) },
  })),
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: isUS ? "How to Take the DMV Practice Eye Test at Home" : "How to Take an Online Vision Test at Home",
  description: meta.description,
  totalTime: "PT10M",
  step: [
    {
      "@type": "HowToStep",
      name: "Calibrate Your Display",
      text: "Hold a standard magnetic credit card or ID card (85.6 mm) against the screen outline and adjust the slider until they match exactly.",
      url: (isUS ? SITE + "/us/" : SITE + "/") + "#screener",
    },
    {
      "@type": "HowToStep",
      name: "Measure the Test Distance",
      text: "Step back 10 feet (3 meters) from your screen, or 20 feet (6 meters) for standard Snellen distance.",
      url: (isUS ? SITE + "/us/" : SITE + "/") + "#screener",
    },
    {
      "@type": "HowToStep",
      name: "Cover One Eye at a Time",
      text: "Gently cover your left eye with your palm without pressing on the eyelid. Read the smallest line of letters you can see, then repeat for the right eye.",
      url: (isUS ? SITE + "/us/" : SITE + "/") + "#screener",
    },
    {
      "@type": "HowToStep",
      name: "Check Your Visual Acuity Score",
      text: "Compare your result (such as 20/20 or 20/40) against the minimum driver licensing and vision screening benchmarks.",
      url: (isUS ? SITE + "/us/" : SITE + "/") + "#reference",
    },
  ],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(appSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(testSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(howToSchema)} />

<a class="skip-link" href="#screener" data-i18n="a11y.skip">{d("a11y.skip")}</a>

<div class="grain" aria-hidden="true"></div>

<header class="site-header" id="siteHeader">
  <div class="header-inner">
    <a class="brand" href="#top" aria-label="Online Vision Test home">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none">
          <path d="M2.5 16c3.4-6.2 8-9.3 13.5-9.3S26.1 9.8 29.5 16c-3.4 6.2-8 9.3-13.5 9.3S5.9 22.2 2.5 16Z" stroke="currentColor" stroke-width="2.1" stroke-linejoin="round"/>
          <circle cx="16" cy="16" r="4.6" fill="currentColor"/>
          <path d="M11.4 20.2 20.6 11.8" stroke="var(--brand-mark-slash, #fff)" stroke-width="1.5" stroke-linecap="round" opacity=".85"/>
        </svg>
      </span>
      <span class="brand-text"><b>Online</b>Vision<span class="brand-tld">Test</span></span>
    </a>

    <nav class="header-nav" id="headerNav" aria-label="Main">
      <a href="#checks" data-i18n="nav.checks">{d("nav.checks")}</a>
      <a href="#screener" data-i18n="nav.start">{d("nav.start")}</a>
      <a href={blogHref} data-i18n="nav.blog">{d("nav.blog")}</a>
      <a href="#faq" data-i18n="nav.faq">{d("nav.faq")}</a>
    </nav>

    <div class="header-tools">
      <label class="lang-wrap" title="Language">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.7 2.6 15.3 0 18M12 3c-2.6 2.7-2.6 15.3 0 18"/></svg>
        <select id="langSelect" aria-label="Language" data-current={locale}>
          <option value="en" selected={locale === "en"}>English</option>
          <option value="es" selected={locale === "es"}>Español</option>
          <option value="fr" selected={locale === "fr"}>Français</option>
          <option value="de" selected={locale === "de"}>Deutsch</option>
          <option value="pt" selected={locale === "pt"}>Português</option>
          <option value="it" selected={locale === "it"}>Italiano</option>
          <option value="ja" selected={locale === "ja"}>日本語</option>
          <option value="ru" selected={locale === "ru"}>Русский</option>
        </select>
      </label>
      <button class="icon-btn" id="themeBtn" type="button" aria-label={d("a11y.theme")} data-i18n-attr="aria-label:a11y.theme">
        <svg class="ico ico-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.4M12 19.6V22M2 12h2.4M19.6 12H22M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M19.1 4.9l-1.7 1.7M6.6 17.4l-1.7 1.7"/></svg>
        <svg class="ico ico-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/></svg>
      </button>
      <a class="btn btn-primary btn-sm header-cta" href="#screener" data-i18n="nav.cta">{d("nav.cta")}</a>
      <button class="icon-btn menu-btn" id="menuBtn" type="button" aria-label={d("a11y.menu")} aria-expanded="false" data-i18n-attr="aria-label:a11y.menu">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 7h17M3.5 12h17M3.5 17h17"/></svg>
      </button>
    </div>
  </div>
  <div class="mobile-nav" id="mobileNav" hidden>
    <a href="#checks" data-i18n="nav.checks">{d("nav.checks")}</a>
    <a href="#screener" data-i18n="nav.start">{d("nav.start")}</a>
    <a href={blogHref} data-i18n="nav.blog">{d("nav.blog")}</a>
    <a href="#faq" data-i18n="nav.faq">{d("nav.faq")}</a>
  </div>
</header>

<main id="top" data-variant={isUS ? "us" : "generic"}>

  {isUS && (
    <div class="container">
      <p class="kicker" style="margin-top:16px">{d("us.banner")} <a href="/">{d("us.banner.back")}</a></p>
      <p class="section-sub">{d("us.distance.note")}</p>
    </div>
  )}

  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="pulse-dot" aria-hidden="true"></span>
          <span data-i18n="hero.eyebrow">{d("hero.eyebrow")}</span>
        </p>
        <h1 data-i18n-html={heroTitleKey} set:html={d(heroTitleKey)}></h1>
        <p class="lede" data-i18n={K("hero.lede")}>{d(K("hero.lede"))}</p>
        <div class="hero-cta">
          <a class="btn btn-primary btn-lg" href="#screener">
            <span data-i18n="hero.cta1">{d("hero.cta1")}</span>
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M12.5 6l6 6-6 6"/></svg>
          </a>
          <a class="btn btn-ghost btn-lg" href="#checks" data-i18n="hero.cta2">{d("hero.cta2")}</a>
        </div>
        <ul class="trust-row">
          <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5"/></svg><span data-i18n="hero.trust1">{d("hero.trust1")}</span></li>
          <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7.5 3v6c0 4.6-3.2 7.6-7.5 9-4.3-1.4-7.5-4.4-7.5-9V6L12 3Z"/></svg><span data-i18n="hero.trust2">{d("hero.trust2")}</span></li>
          <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.2l3.4 2"/></svg><span data-i18n="hero.trust3">{d("hero.trust3")}</span></li>
        </ul>
        <p class="hero-note" data-i18n="hero.note">{d("hero.note")}</p>
      </div>

      <div class="hero-visual">
        <div class="chart-card" id="heroChartCard">
          <div class="chart-card-head">
            <span class="card-label" data-i18n="hero.chartLabel">{d("hero.chartLabel")}</span>
            <span class="pill pill-line" data-i18n="hero.chartPill">{d("hero.chartPill")}</span>
          </div>
          <div class="chart-lines" id="heroChart" aria-hidden="true"></div>
          <div class="chart-card-foot">
            <span class="mini">
              <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8V5.5A1.5 1.5 0 0 1 5.5 4H8M16 4h2.5A1.5 1.5 0 0 1 20 5.5V8M20 16v2.5a1.5 1.5 0 0 1-1.5 1.5H16M8 20H5.5A1.5 1.5 0 0 1 4 18.5V16"/></svg>
              <span data-i18n="hero.calibrated">{d("hero.calibrated")}</span>
            </span>
            <span class="mini">
              <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17l6-7 4 4.5L21 6"/></svg>
              <span data-i18n="hero.distance">{d("hero.distance")}</span>
            </span>
          </div>
        </div>
        <div class="float-badge badge-a">
          <span class="badge-ring" aria-hidden="true"></span>
          <span><b>20/40</b><small data-i18n={K("hero.badgeA")}>{d(K("hero.badgeA"))}</small></span>
        </div>
        <div class="float-badge badge-b">
          <span><b data-i18n="hero.badgeBTitle">{d("hero.badgeBTitle")}</b><small data-i18n="hero.badgeB">{d("hero.badgeB")}</small></span>
        </div>
      </div>
    </div>

    <div class="container">
      <ul class="stat-strip">
        <li><b>{isUS ? "12" : "11"}</b><span data-i18n="stats.checks">{d("stats.checks")}</span></li>
        <li><b>20/40</b><span data-i18n="stats.bench">{d("stats.bench")}</span></li>
        <li><b>8</b><span data-i18n="stats.langs">{d("stats.langs")}</span></li>
      </ul>
    </div>
  </section>

  {!isUS && locale === "en" && (
    <section class="section" id="us-test">
      <div class="container">
        <div class="how-card">
          <span class="how-num">US</span>
          <h2>{d("us.card.title")}</h2>
          <p>{d("us.card.body")}</p>
          <p><a class="btn btn-primary btn-sm" href="/us/">{d("us.card.cta")}</a></p>
        </div>
      </div>
    </section>
  )}

  {isUS && (
    <section class="section" id="states">
      <div class="container">
        <div class="section-head">
          <p class="kicker" data-i18n="states.kicker">{d("states.kicker")}</p>
          <h2 data-i18n="states.title">{d("states.title")}</h2>
          <p class="section-sub" data-i18n="states.sub">{d("states.sub")}</p>
          <p class="section-sub" style="margin-top:0.5rem; color:var(--muted); font-size:0.9rem;">
            <em>Last reviewed: September 2026. Official sources: State DMV/DPS manuals.</em>
          </p>
        </div>
        <div class="featured-states" id="featuredStates"></div>
        <div class="table-card">
          <div class="table-tools">
            <label class="search-wrap">
              <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="M16 16l4.5 4.5"></path></svg>
              <input id="stateSearch" type="search" placeholder={d("states.search")} aria-label={d("states.search")} autocomplete="off" />
            </label>
            <div class="legend">
              <span class="chip chip-ok" data-i18n="states.legendOk">{d("states.legendOk")}</span>
              <span class="chip chip-mid" data-i18n="states.legendMid">{d("states.legendMid")}</span>
              <span class="chip chip-warn" data-i18n="states.legendWarn">{d("states.legendWarn")}</span>
            </div>
          </div>
          <div class="table-scroll">
            <table class="state-table">
              <thead>
                <tr>
                  <th data-i18n="states.colState">{d("states.colState")}</th>
                  <th data-i18n="states.colAcuity">{d("states.colAcuity")}</th>
                  <th data-i18n="states.colIfBelow">{d("states.colIfBelow")}</th>
                  <th data-i18n="states.colRenewal">{d("states.colRenewal")}</th>
                </tr>
              </thead>
              <tbody id="stateTableBody"></tbody>
            </table>
          </div>
          <p class="table-foot" data-i18n="states.foot">{d("states.foot")}</p>
        </div>
      </div>
    </section>
  )}

  <section class="section" id="how">
    <div class="container">
      <div class="section-head">
        <p class="kicker" data-i18n="how.kicker">{d("how.kicker")}</p>
        <h2 data-i18n="how.title">{d("how.title")}</h2>
        <p class="section-sub" data-i18n="how.sub">{d("how.sub")}</p>
      </div>
      <ol class="how-grid">
        <li class="how-card">
          <span class="how-num">01</span>
          <h3 data-i18n="how.s1t">{d("how.s1t")}</h3>
          <p data-i18n="how.s1b">{d("how.s1b")}</p>
        </li>
        <li class="how-card">
          <span class="how-num">02</span>
          <h3 data-i18n="how.s2t">{d("how.s2t")}</h3>
          <p data-i18n="how.s2b">{d("how.s2b")}</p>
        </li>
        <li class="how-card">
          <span class="how-num">03</span>
          <h3 data-i18n="how.s3t">{d("how.s3t")}</h3>
          <p data-i18n="how.s3b">{d("how.s3b")}</p>
        </li>
        <li class="how-card">
          <span class="how-num">04</span>
          <h3 data-i18n="how.s4t">{d("how.s4t")}</h3>
          <p data-i18n="how.s4b">{d("how.s4b")}</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section-checks" id="checks">
    <div class="container">
      <div class="section-head">
        <p class="kicker" data-i18n="checks.kicker">{d("checks.kicker")}</p>
        <h2 data-i18n={K("checks.title")}>{d(K("checks.title"))}</h2>
        <p class="section-sub" data-i18n="checks.sub">{d("checks.sub")}</p>
      </div>
      <div class="check-grid" id="checkGrid">
        {checkList.map((c) => (
          <button
            type="button"
            class="check-card"
            data-test={c.test}
            style={`--cc:${c.color}`}
            aria-label={`${d(`checks.${c.id}.name`)} — ${d("checks.open")}`}
          >
            <span class="check-ico" aria-hidden="true">
              <svg class="ico" viewBox="0 0 24 24" set:html={ICONS[c.icon] || ""}></svg>
            </span>
            <strong class="card-title">{d(`checks.${c.id}.name`)}</strong>
            <p>{d(`checks.${c.id}.desc`)}</p>
            <div class="check-foot">
              <span class="check-tag">{c.tag}</span>
              <span class="check-go" aria-hidden="true">
                {d("checks.open")}
                <svg class="ico" viewBox="0 0 24 24"><path d="M5 12h13M12.5 6l6 6-6 6"/></svg>
              </span>
            </div>
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-screener" id="screener">
    <div class="container">
      <div class="section-head section-head-light">
        <p class="kicker" data-i18n="lab.kicker">{d("lab.kicker")}</p>
        <h2 data-i18n="lab.title">{d("lab.title")}</h2>
        <p class="section-sub" data-i18n="lab.sub">{d("lab.sub")}</p>
      </div>

      <div class="lab" id="lab">
        <div class="lab-bar">
          <div class="lab-bar-left">
            <span class="lab-dot" aria-hidden="true"></span>
            <span id="labStatus" data-i18n="lab.ready">{d("lab.ready")}</span>
          </div>
          <div class="lab-bar-right">
            <button class="btn btn-quiet btn-xs" id="labFullBtn" type="button" data-i18n="lab.focus">{d("lab.focus")}</button>
            <button class="btn btn-quiet btn-xs" id="labResetBtn" type="button" data-i18n="lab.reset">{d("lab.reset")}</button>
          </div>
        </div>
        <div class="stepper-wrap" id="stepperWrap">
          <ol class="stepper" id="stepper"></ol>
        </div>
        <div class="lab-norm" id="labNorm" hidden></div>
        <div class="lab-stage" id="labStage"><p class="stage-sub" data-lab-fallback>{d("lab.ready")}</p></div>
        <div class="lab-foot" id="labFoot"></div>
        <noscript><p class="stage-sub">{d("lab.ready")}</p></noscript>
      </div>
    </div>
  </section>

  <section class="section section-refs" id="reference">
    <div class="container">
      <div class="section-head">
        <p class="kicker" data-i18n="refs.kicker">{d("refs.kicker")}</p>
        <h2 data-i18n="refs.title">{d("refs.title")}</h2>
        <p class="section-sub" data-i18n="refs.sub">{d("refs.sub")}</p>
      </div>
      <div class="ref-grid" id="refGrid">
        {REFS.map((r) => (
          <a class="ref-card" href={r.url} target="_blank" rel="noopener noreferrer">
            <span class="ref-badge" data-i18n="refs.learn">{d("refs.learn")}</span>
            <h3>{d("refs." + r.id + ".t")}</h3>
            <p>{d("refs." + r.id + ".b")}</p>
            <span class="ref-go">
              {new URL(r.url).hostname.replace(/^www\./, "")}
              <svg class="ico" viewBox="0 0 24 24"><path d="M5 12h13M12.5 6l6 6-6 6"/></svg>
            </span>
          </a>
        ))}
      </div>
      <div class="ref-links">
        <div class="ref-col">
          <h3 data-i18n="refs.sources">{d("refs.sources")}</h3>
          <ul class="ref-list" id="sourceList">
            {SOURCES.map((s) => (
              <li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.name}</a></li>
            ))}
          </ul>
        </div>
        {isUS && (
          <div class="ref-col">
            <h3 data-i18n="refs.dmv">{d("refs.dmv")}</h3>
            <ul class="ref-list" id="dmvList">
              {DMV_LINKS.map((dmv) => (
                <li><a href={dmv.url} target="_blank" rel="noopener noreferrer"><b>{dmv.code}</b>{dmv.name}</a></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="container">
      <div class="section-head">
        <p class="kicker" data-i18n="faq.kicker">{d("faq.kicker")}</p>
        <h2 data-i18n="faq.title">{d("faq.title")}</h2>
      </div>
      <div class="faq-list" id="faqList">
        {faqNums.map((n) => (
          <details class="faq-item">
            <summary>{d(`faq.q${n}`)}</summary>
            <div class="faq-body">{d(`faq.a${n}`)}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  {meta.body && meta.body.length > 0 && (
    <section class="section" id="guide">
      <div class="container">
        <div class="section-head">
          <p class="kicker">{isUS ? "DMV Reference Guide" : d("nav.start")}</p>
          <h2>{meta.articleTitle || (isUS ? "DMV Vision Guide" : d("nav.start"))}</h2>
        </div>
        <article class="prose" style="max-width: 800px;">
          {meta.body.map((sec) => (
            <div style="margin-bottom: 28px;">
              <h3 style="margin-bottom: 8px;">{sec.h}</h3>
              <p>{sec.p}</p>
            </div>
          ))}
        </article>
      </div>
    </section>
  )}

</main>

