---
/**
 * The single-page application, extracted from the generator's index.html.
 *
 * Structure, ids, classes and every data-i18n key are unchanged, so lab.js,
 * app.js and the eight-language switcher keep working exactly as before.
 *
 * The only server-side additions are the hero strings: they are rendered from
 * the same src/scripts/i18n.js dictionary the client hydrates from, so a
 * non-English route ships a genuinely translated H1 and lede in the HTML with
 * no post-load swap. Everything below the fold is translated on hydrate.
 */

import { DICT } from "../scripts/i18n.ts";
import { FAQ_COUNT, US_ONLY_FAQ_NUMS } from "../scripts/data.ts";
import { seoFor } from "../data/seo.ts";
import { SITE, LOCALES } from "../lib/site.ts";

const { locale = "en", variant = "generic" } = Astro.props;
// The US DMV practice screener lives only on /us/. Every homepage route (/,
// /es/, ...) renders the generic vision check, whatever the language.
const isUS = variant === "us";
// English generic homepage uses neutral gen.* keys (DMV wording stays on /us/).
// Other locales already render their own generic copy, so they are untouched.
const useGen = !isUS && locale === "en";
const K = (k) => (useGen ? "gen." + k : k);
// /us/ carries the exact main keyword in its H1; every other page keeps its own.
const heroTitleKey = isUS ? "us.hero.title" : K("hero.title");
const faqNums = Array.from({ length: FAQ_COUNT }, (_, i) => i + 1).filter(
  (n) => isUS || !US_ONLY_FAQ_NUMS.includes(n)
);
const dict = DICT[locale] || DICT.en;
const d = (k) => (dict[k] != null ? dict[k] : DICT.en[k] != null ? DICT.en[k] : k);
const meta = seoFor(locale, isUS ? "us" : "home");
const blogHref = locale === "en" ? "/blog/" : "/" + locale + "/blog/";

const strip = (s) => String(s).replace(/<[^>]+>/g, " ").replace(/&nbsp;/g, " ").replace(/\s+/g, " ").trim();

const appSchema = {
  "@context": "https://schema.org",
  "@type": ["WebApplication", "HealthApplication", "MedicalWebPage"],
  name: "Online Vision Test",
  url: isUS ? SITE + "/us/" : SITE + "/",
  applicationCategory: "HealthApplication",
  operatingSystem: "Any modern web browser",
  browserRequirements: "Requires JavaScript and a calibrated display.",
  inLanguage: LOCALES,
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description: meta.description,
  publisher: { "@type": "Organization", name: "Online Vision Test", url: SITE + "/" },
};

const testSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalTest",
  name: isUS ? "DMV Practice Eye Test" : "Online Vision Screening Test",
  usesDevice: "Computer monitor or smartphone screen",
  purpose: "Screening simulation for visual acuity",
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: locale,
  mainEntity: faqNums.map((n) => ({
    "@type": "Question",
    name: strip(d("faq.q" + n)),
    acceptedAnswer: { "@type": "Answer", text: strip(d("faq.a" + n)) },
  })),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(appSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(testSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

<a class="skip-link" href="#screener" data-i18n="a11y.skip">Skip to the vision check</a>

<div class="grain" aria-hidden="true"></div>

<header class="site-header" id="siteHeader">
  <div class="header-inner">
    <a class="brand" href="#top" aria-label="Online Vision Test home">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none">
          <path d="M2.5 16c3.4-6.2 8-9.3 13.5-9.3S26.1 9.8 29.5 16c-3.4 6.2-8 9.3-13.5 9.3S5.9 22.2 2.5 16Z" stroke="currentColor" stroke-width="2.1" stroke-linejoin="round"/>
          <circle cx="16" cy="16" r="4.6" fill="currentColor"/>
          <path d="M11.4 20.2 20.6 11.8" stroke="var(--brand-mark-slash, #fff)" stroke-width="1.5" stroke-linecap="round" opacity=".85"/>
        </svg>
      </span>
      <span class="brand-text"><b>Online</b>Vision<span class="brand-tld">Test</span></span>
    </a>

    <nav class="header-nav" id="headerNav" aria-label="Main">
      <a href="#checks" data-i18n="nav.checks">Checks</a>
      <a href="#screener" data-i18n="nav.start">Vision check</a>
      <a href={blogHref} data-i18n="nav.blog">Blog</a>
      <a href="#faq" data-i18n="nav.faq">FAQ</a>
    </nav>

    <div class="header-tools">
      <label class="lang-wrap" title="Language">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.7 2.6 15.3 0 18M12 3c-2.6 2.7-2.6 15.3 0 18"/></svg>
        <select id="langSelect" aria-label="Language" data-current={locale}>
          <option value="en" selected={locale === "en"}>English</option>
          <option value="es" selected={locale === "es"}>Español</option>
          <option value="fr" selected={locale === "fr"}>Français</option>
          <option value="de" selected={locale === "de"}>Deutsch</option>
          <option value="pt" selected={locale === "pt"}>Português</option>
          <option value="it" selected={locale === "it"}>Italiano</option>
          <option value="ja" selected={locale === "ja"}>日本語</option>
          <option value="ru" selected={locale === "ru"}>Русский</option>
        </select>
      </label>
      <button class="icon-btn" id="themeBtn" type="button" aria-label="Toggle dark mode" data-i18n-attr="aria-label:a11y.theme">
        <svg class="ico ico-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.4M12 19.6V22M2 12h2.4M19.6 12H22M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M19.1 4.9l-1.7 1.7M6.6 17.4l-1.7 1.7"/></svg>
        <svg class="ico ico-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/></svg>
      </button>
      <a class="btn btn-primary btn-sm header-cta" href="#screener" data-i18n="nav.cta">Start free check</a>
      <button class="icon-btn menu-btn" id="menuBtn" type="button" aria-label="Menu" aria-expanded="false" data-i18n-attr="aria-label:a11y.menu">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 7h17M3.5 12h17M3.5 17h17"/></svg>
      </button>
    </div>
  </div>
  <div class="mobile-nav" id="mobileNav" hidden>
    <a href="#checks" data-i18n="nav.checks">Checks</a>
    <a href="#screener" data-i18n="nav.start">Vision check</a>
    <a href={blogHref} data-i18n="nav.blog">Blog</a>
    <a href="#faq" data-i18n="nav.faq">FAQ</a>
  </div>
</header>

<main id="top" data-variant={isUS ? "us" : "generic"}>

  {isUS && (
    <div class="container">
      <p class="kicker" style="margin-top:16px">{d("us.banner")} <a href="/">{d("us.banner.back")}</a></p>
      <p class="section-sub">{d("us.distance.note")}</p>
    </div>
  )}

  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="pulse-dot" aria-hidden="true"></span>
          <span data-i18n="hero.eyebrow">{d("hero.eyebrow")}</span>
        </p>
        <h1 data-i18n-html={heroTitleKey} set:html={d(heroTitleKey)}></h1>
        <p class="lede" data-i18n={K("hero.lede")}>{d(K("hero.lede"))}</p>
        <div class="hero-cta">
          <a class="btn btn-primary btn-lg" href="#screener">
            <span data-i18n="hero.cta1">Start the free vision check</span>
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M12.5 6l6 6-6 6"/></svg>
          </a>
          <a class="btn btn-ghost btn-lg" href="#checks" data-i18n="hero.cta2">View all checks</a>
        </div>
        <ul class="trust-row">
          <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5"/></svg><span data-i18n="hero.trust1">Nothing to install or sign up for</span></li>
          <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7.5 3v6c0 4.6-3.2 7.6-7.5 9-4.3-1.4-7.5-4.4-7.5-9V6L12 3Z"/></svg><span data-i18n="hero.trust2">Results never leave your browser</span></li>
          <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.2l3.4 2"/></svg><span data-i18n="hero.trust3">About ten minutes, eye by eye</span></li>
        </ul>
        <p class="hero-note" data-i18n="hero.note">{d("hero.note")}</p>
      </div>

      <div class="hero-visual">
        <div class="chart-card" id="heroChartCard">
          <div class="chart-card-head">
            <span class="card-label" data-i18n="hero.chartLabel">Snellen chart · 6 m</span>
            <span class="pill pill-line" data-i18n="hero.chartPill">20/40 pass line</span>
          </div>
          <div class="chart-lines" id="heroChart" aria-hidden="true"></div>
          <div class="chart-card-foot">
            <span class="mini">
              <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8V5.5A1.5 1.5 0 0 1 5.5 4H8M16 4h2.5A1.5 1.5 0 0 1 20 5.5V8M20 16v2.5a1.5 1.5 0 0 1-1.5 1.5H16M8 20H5.5A1.5 1.5 0 0 1 4 18.5V16"/></svg>
              <span data-i18n="hero.calibrated">Screen calibrated</span>
            </span>
            <span class="mini">
              <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17l6-7 4 4.5L21 6"/></svg>
              <span data-i18n="hero.distance">Stand 3 m away</span>
            </span>
          </div>
        </div>
        <div class="float-badge badge-a">
          <span class="badge-ring" aria-hidden="true"></span>
          <span><b>20/40</b><small data-i18n="hero.badgeA">{isUS ? "Most US DMV benchmark" : "20/40 reference line"}</small></span>
        </div>
        <div class="float-badge badge-b">
          <span><b data-i18n="hero.badgeBTitle">Left eye first</b><small data-i18n="hero.badgeB">Cover, read, swap</small></span>
        </div>
      </div>
    </div>

    <div class="container">
      <ul class="stat-strip">
        <li><b>{isUS ? "12" : "11"}</b><span data-i18n="stats.checks">practice checks</span></li>
        <li><b>20/40</b><span data-i18n="stats.bench">unrestricted benchmark</span></li>
        <li><b>8</b><span data-i18n="stats.langs">languages</span></li>
      </ul>
    </div>
  </section>

  {!isUS && locale === "en" && (
    <section class="section" id="us-test">
      <div class="container">
        <div class="how-card">
          <span class="how-num">US</span>
          <h3>{d("us.card.title")}</h3>
          <p>{d("us.card.body")}</p>
          <p><a class="btn btn-primary btn-sm" href="/us/">{d("us.card.cta")}</a></p>
        </div>
      </div>
    </section>
  )}

  <section class="section" id="how">
    <div class="container">
      <div class="section-head">
        <p class="kicker" data-i18n="how.kicker">How it works</p>
        <h2 data-i18n="how.title">Ten minutes, replicated procedure</h2>
        <p class="section-sub" data-i18n="how.sub">The order matches what happens at the counter: calibrate, distance, occlude, read. Do it the same way each time and the numbers mean something.</p>
      </div>
      <ol class="how-grid">
        <li class="how-card">
          <span class="how-num">01</span>
          <h3 data-i18n="how.s1t">Calibrate your screen</h3>
          <p data-i18n="how.s1b">Hold a bank card against the on-screen outline and slide until the sizes match. That turns millimetres into pixels so the letters are the real size.</p>
        </li>
        <li class="how-card">
          <span class="how-num">02</span>
          <h3 data-i18n="how.s2t">Set your distance</h3>
          <p data-i18n="how.s2b">Pick 3 m or 6 m, mark the spot on the floor, and dim the room. Bright screens and short distances flatter your eyes.</p>
        </li>
        <li class="how-card">
          <span class="how-num">03</span>
          <h3 data-i18n="how.s3t">Cover one eye</h3>
          <p data-i18n="how.s3b">Cup — never press — one eye with your palm, then the other. Both eyes together are tested last.</p>
        </li>
        <li class="how-card">
          <span class="how-num">04</span>
          <h3 data-i18n="how.s4t">Read the smallest line</h3>
          <p data-i18n="how.s4b">Type or tap the letters you actually see. Miss twice in a row and the screener stops you there — guessing hides the problem you came to find.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section-checks" id="checks">
    <div class="container">
      <div class="section-head">
        <p class="kicker" data-i18n="checks.kicker">What gets checked</p>
        <h2 data-i18n={K("checks.title")}>{d(K("checks.title"))}</h2>
        <p class="section-sub" data-i18n="checks.sub">Jump straight into any single check, or run the full sequence.</p>
      </div>
      <div class="check-grid" id="checkGrid"></div>
    </div>
  </section>

  <section class="section section-screener" id="screener">
    <div class="container">
      <div class="section-head section-head-light">
        <p class="kicker" data-i18n="lab.kicker">The screener</p>
        <h2 data-i18n="lab.title">Run the full check</h2>
        <p class="section-sub" data-i18n="lab.sub">Work through it in order. Nothing is uploaded — the whole screener runs on this device.</p>
      </div>

      <div class="lab" id="lab">
        <div class="lab-bar">
          <div class="lab-bar-left">
            <span class="lab-dot" aria-hidden="true"></span>
            <span id="labStatus" data-i18n="lab.ready">Ready when you are</span>
          </div>
          <div class="lab-bar-right">
            <button class="btn btn-quiet btn-xs" id="labFullBtn" type="button" data-i18n="lab.focus">Focus mode</button>
            <button class="btn btn-quiet btn-xs" id="labResetBtn" type="button" data-i18n="lab.reset">Restart</button>
          </div>
        </div>
        <div class="stepper-wrap" id="stepperWrap">
          <ol class="stepper" id="stepper"></ol>
        </div>
        <div class="lab-norm" id="labNorm" hidden></div>
        <div class="lab-stage" id="labStage"><p class="stage-sub" data-lab-fallback>Loading the vision checks… if nothing appears, enable JavaScript and reload.</p></div>
        <div class="lab-foot" id="labFoot"></div>
        <noscript><p class="stage-sub">The vision checks need JavaScript. Enable it and reload to run the screener.</p></noscript>
      </div>
    </div>
  </section>


  <section class="section section-refs" id="reference">
    <div class="container">
      <div class="section-head">
        <p class="kicker" data-i18n="refs.kicker">Evidence &amp; standards</p>
        <h2 data-i18n="refs.title">Built on the tests eye professionals actually use</h2>
        <p class="section-sub" data-i18n="refs.sub">Every check follows a published protocol. None of them diagnose anything on their own — they exist so you arrive at your appointment prepared.</p>
      </div>
      <div class="ref-grid" id="refGrid"></div>
      <div class="ref-links">
        <div class="ref-col">
          <h3 data-i18n="refs.sources">Sources &amp; further reading</h3>
          <ul class="ref-list" id="sourceList"></ul>
        </div>
        {isUS && (
        <div class="ref-col">
          <h3 data-i18n="refs.dmv">Official state licensing agencies</h3>
          <ul class="ref-list" id="dmvList"></ul>
        </div>
        )}
      </div>
    </div>
  </section>



  <section class="section" id="faq">
    <div class="container">
      <div class="section-head">
        <p class="kicker" data-i18n="faq.kicker">Questions</p>
        <h2 data-i18n="faq.title">Before you start</h2>
      </div>
      <div class="faq-list" id="faqList"></div>
    </div>
  </section>

</main>

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="brand" href="#top">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none">
            <path d="M2.5 16c3.4-6.2 8-9.3 13.5-9.3S26.1 9.8 29.5 16c-3.4 6.2-8 9.3-13.5 9.3S5.9 22.2 2.5 16Z" stroke="currentColor" stroke-width="2.1" stroke-linejoin="round"/>
            <circle cx="16" cy="16" r="4.6" fill="currentColor"/>
          </svg>
        </span>
        <span class="brand-text"><b>Online</b>Vision<span class="brand-tld">Test</span></span>
      </a>
      <p data-i18n={K("footer.tagline")}>{d(K("footer.tagline"))}</p>
      <p class="footer-langs" data-i18n="footer.langs">Available in English, Spanish, French, German, Portuguese, Italian, Japanese and Russian.</p>
    </div>
    <nav class="footer-col" aria-label="Checks">
      <h3 data-i18n="footer.c1">Checks</h3>
      <a href="#screener" data-i18n="checks.distance.name">Distance acuity</a>
      <a href="#screener" data-i18n="checks.tumbling.name">Tumbling-E</a>
      <a href="#screener" data-i18n="checks.color.name">Colour vision</a>
      <a href="#screener" data-i18n="checks.peripheral.name">Peripheral awareness</a>
      <a href="#screener" data-i18n="checks.near.name">Near vision</a>
      <a href="#screener" data-i18n="checks.contrast.name">Contrast sensitivity</a>
      <a href="#screener" data-i18n="checks.astigmatism.name">Astigmatism dial</a>
      <a href="#screener" data-i18n="checks.refraction.name">Refraction screening</a>
      <a href="#screener" data-i18n="checks.stereo.name">Depth perception</a>
    </nav>
    <nav class="footer-col" aria-label="Guides">
      <h3 data-i18n="footer.c2">Guides</h3>
      <a href={blogHref} data-i18n="nav.blog">Blog</a>
      {locale === "en" && !isUS && (<a href="/us/">{d("footer.us")}</a>)}
      <a href="#faq" data-i18n="footer.g4">Screening limits</a>
      <a href="#reference" data-i18n="refs.kicker">Evidence &amp; standards</a>
    </nav>
    <div class="footer-col">
      <h3 data-i18n="footer.c3">Privacy</h3>
      <p data-i18n="footer.p1">No account, no tracking pixel, no uploads. Results are kept in this browser's own storage and can be cleared at any time.</p>
    </div>
  </div>
  <div class="container">
    <div class="disclaimer" role="note" aria-label="Medical and legal notice">
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5 21 19H3l9-15.5Z"/><path d="M12 10v4.2M12 16.6v.1"/></svg>
      <p data-i18n="footer.disclaimer">This site is an educational practice screener only. It is not an official medical examination, and it cannot diagnose an eye condition or produce a prescription. Screen-based results are affected by your monitor, room lighting and viewing distance. If a check suggests a problem, or you have any concern about your vision, see an optometrist or ophthalmologist before you rely on these results.</p>
    </div>
    <p class="copyright"><span id="year"></span> <span data-i18n="footer.copy">Online Vision Test. Practice screener, free to use.</span></p>
  </div>
</footer>

<script>
  import "../scripts/app.ts";
</script>
