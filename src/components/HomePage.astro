---
/**
 * The single-page application, extracted from the generator's index.html.
 *
 * Structure, ids, classes and every data-i18n key are unchanged, so lab.ts,
 * app.ts and the eight-language switcher keep working exactly as before.
 *
 * Every data-i18n element, check card, reference card, and FAQ item is
 * server-rendered from the same src/scripts/i18n.ts dictionary the client
 * hydrates from, so every locale route ships 100% localized HTML with zero
 * untranslated English fallback text before JavaScript runs.
 */

import { DICT } from "../scripts/dict.ts";
import {
  FAQ_COUNT,
  US_ONLY_FAQ_NUMS,
  CHECKS,
  US_ONLY_CHECK_IDS,
  REFS,
  SOURCES,
  DMV_LINKS,
} from "../scripts/data.ts";
import { seoFor } from "../data/seo.ts";
import { SITE } from "../lib/site.ts";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import "../styles/landing.css";

const { locale = "en", variant = "generic" } = Astro.props;
// The US DMV practice screener lives only on /us/. Every homepage route (/,
// /es/, ...) renders the generic vision check, whatever the language.
const isUS = variant === "us";
// English generic homepage uses neutral gen.* keys (DMV wording stays on /us/).
// Other locales already render their own generic copy, so they are untouched.
const useGen = !isUS && locale === "en";
const K = (k) => (useGen ? "gen." + k : k);
// /us/ carries the exact main keyword in its H1; every other page keeps its own.
const heroTitleKey = isUS ? "us.hero.title" : K("hero.title");
const faqNums = Array.from({ length: FAQ_COUNT }, (_, i) => i + 1).filter(
  (n) => isUS || !US_ONLY_FAQ_NUMS.includes(n)
);
const checkList = isUS
  ? CHECKS
  : CHECKS.filter((c) => !US_ONLY_CHECK_IDS.includes(c.id));
const dict = DICT[locale] || DICT.en;
const d = (k) => (dict[k] != null ? dict[k] : DICT.en[k] != null ? DICT.en[k] : k);
const meta = seoFor(locale, isUS ? "us": "DMV Practice");
const blogHref = locale === "en" ? "/blog/" : "/" + locale + "/blog/";
const homeHref = isUS ? "/us/" : locale === "en" ? "/" : "/" + locale + "/";
const aboutHref = locale === "en" ? "/about/" : "/" + locale + "/about/";
const contactHref = locale === "en" ? "/contact/" : "/" + locale + "/contact/";
const testHref = locale === "en" ? "/test/" : "/" + locale + "/test/";

const strip = (s) => String(s).replace(/<[^>]+>/g, " ").replace(/&nbsp;/g, " ").replace(/\s+/g, " ").trim();

const appSchema = {
  "@context": "https://schema.org",
  "@type": ["WebApplication", "HealthApplication", "MedicalWebPage"],
  name: "Online Vision Test",
  url: isUS ? SITE + "/us/" : locale === "en" ? SITE + "/" : SITE + "/" + locale + "/",
  applicationCategory: "HealthApplication",
  operatingSystem: "Any modern web browser",
  browserRequirements: "Requires JavaScript and a calibrated display.",
  inLanguage: locale,
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description: meta.description,
  publisher: { "@type": "Organization", name: "Online Vision Test", url: SITE + "/" },
};

const testSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalTest",
  name: isUS ? "DMV Practice Eye Test" : "Online Vision Screening Test",
  usesDevice: "Computer monitor or smartphone screen",
  purpose: "Screening simulation for visual acuity",
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: locale,
  mainEntity: faqNums.map((n) => ({
    "@type": "Question",
    name: strip(d("faq.q" + n)),
    acceptedAnswer: { "@type": "Answer", text: strip(d("faq.a" + n)) },
  })),
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: isUS ? d("us.schema.howTo.name") : d("schema.howTo.name"),
  description: meta.description,
  totalTime: "PT10M",
  step: [
    {
      "@type": "HowToStep",
      name: d("schema.howTo.step1.name"),
      text: d("schema.howTo.step1.text"),
      url: (isUS ? SITE + "/us/" : locale === "en" ? SITE + "/" : SITE + "/" + locale + "/") + "#screener",
    },
    {
      "@type": "HowToStep",
      name: d("schema.howTo.step2.name"),
      text: d("schema.howTo.step2.text"),
      url: (isUS ? SITE + "/us/" : locale === "en" ? SITE + "/" : SITE + "/" + locale + "/") + "#screener",
    },
    {
      "@type": "HowToStep",
      name: d("schema.howTo.step3.name"),
      text: d("schema.howTo.step3.text"),
      url: (isUS ? SITE + "/us/" : locale === "en" ? SITE + "/" : SITE + "/" + locale + "/") + "#screener",
    },
    {
      "@type": "HowToStep",
      name: d("schema.howTo.step4.name"),
      text: d("schema.howTo.step4.text"),
      url: (isUS ? SITE + "/us/" : locale === "en" ? SITE + "/" : SITE + "/" + locale + "/") + "#reference",
    },
  ],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(appSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(testSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(howToSchema)} />

<a class="skip-link" href={testHref} data-i18n="a11y.skip">{d("a11y.skip")}</a>

<div class="grain" aria-hidden="true"></div>

<div class="home-page site-shell" id="top">
  <section class="hero">
    <div class="hero-image" aria-hidden="true"></div>
    <div class="hero-shade" aria-hidden="true"></div>

    <SiteHeader locale={locale} page={isUS ? "us" : "home"} />

    {isUS && (
      <div class="page-pad" style="padding-top: 16px; position: relative; z-index: 5;">
        <p class="hero-kicker"><span class="kicker-line"></span> {d("us.banner")} <a href="/" style="color: #badc7b; text-decoration: underline; margin-left: 8px;">{d("us.banner.back")}</a></p>
        <p style="color: #b7cac1; font-size: 13px; margin: 4px 0 0 44px;">{d("us.distance.note")}</p>
      </div>
    )}

    <div class="hero-content page-pad">
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="hero-kicker">
            <span class="kicker-line"></span>
            <span data-i18n="hero.eyebrow">{d("hero.eyebrow")}</span>
          </div>
          <h1 data-i18n-html={heroTitleKey} set:html={d(heroTitleKey)}></h1>
          <p class="lede" data-i18n={K("hero.lede")}>{d(K("hero.lede"))}</p>
          <div class="hero-actions">
            <a class="button button-lime" href={testHref}>
              <span data-i18n="hero.cta1">{d("hero.cta1")}</span>
              <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
            </a>
            <a class="text-link light" href="#how">
              <span data-i18n="hero.cta2">{d("hero.cta2")}</span>
              <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M12.5 6l6 6-6 6"/></svg>
            </a>
          </div>
          <div class="hero-meta">
            <p class="hero-trust-line">
              <span data-i18n="hero.trust1">{d("hero.trust1")}</span>
              <span class="sep" aria-hidden="true">·</span>
              <span data-i18n="hero.trust2">{d("hero.trust2")}</span>
              <span class="sep" aria-hidden="true">·</span>
              <span data-i18n="hero.trust3">{d("hero.trust3")}</span>
            </p>
            <p class="hero-note" data-i18n="hero.note">{d("hero.note")}</p>
          </div>
        </div>

        <div class="hero-visual">
          <div class="chart-card" id="heroChartCard">
            <div class="chart-card-head">
              <span class="card-label" data-i18n="hero.chartLabel">{d("hero.chartLabel")}</span>
              <span class="chart-bench-indicator" data-i18n="hero.chartPill">{d("hero.chartPill")}</span>
            </div>
            <div class="chart-lines" id="heroChart" aria-hidden="true"></div>
            <div class="chart-card-foot">
              <span class="mini">
                <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8V5.5A1.5 1.5 0 0 1 5.5 4H8M16 4h2.5A1.5 1.5 0 0 1 20 5.5V8M20 16v2.5a1.5 1.5 0 0 1-1.5 1.5H16M8 20H5.5A1.5 1.5 0 0 1 4 18.5V16"/></svg>
                <span data-i18n="hero.calibrated">{d("hero.calibrated")}</span>
              </span>
              <span class="mini">
                <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17l6-7 4 4.5L21 6"/></svg>
                <span data-i18n="hero.distance">{d("hero.distance")}</span>
              </span>
            </div>
          </div>
          <div class="chart-sub-strip">
            <div class="strip-item">
              <span class="strip-num">20/40</span>
              <span class="strip-desc" data-i18n={K("hero.badgeA")}>{d(K("hero.badgeA"))}</span>
            </div>
            <div class="strip-item">
              <span class="strip-num" data-i18n="hero.badgeBTitle">{d("hero.badgeBTitle")}</span>
              <span class="strip-desc" data-i18n="hero.badgeB">{d("hero.badgeB")}</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-bottom page-pad">
      <span data-i18n="hero.bottom.tagline">{d("hero.bottom.tagline")}</span>
      <a href="#how" aria-label="Scroll to how it works">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
      </a>
    </div>
  </section>

  <main data-variant={isUS ? "us": "DMV Practice"}>
    <section class="stat-section page-pad">
      <ul class="stat-strip">
        <li><b>{isUS ? "13" : "12"}</b><span data-i18n="stats.checks">{d("stats.checks")}</span></li>
        <li><b>20/40</b><span data-i18n="stats.bench">{d("stats.bench")}</span></li>
        <li><b>8</b><span data-i18n="stats.langs">{d("stats.langs")}</span></li>
      </ul>
    </section>

    {!isUS && locale === "en" && (
      <section class="section-us-callout page-pad" id="us-test">
        <div class="us-card-panel">
          <span class="check-category">US PRACTICE</span>
          <h2>{d("us.card.title")}</h2>
          <p>{d("us.card.body")}</p>
          <a class="button button-dark" href="/us/">
            <span>{d("us.card.cta")}</span>
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
          </a>
        </div>
      </section>
    )}

    {isUS && (
      <section class="states-section page-pad" id="states">
        <div class="section-label">
          <span class="label-dot"></span>
          <span data-i18n="states.kicker">{d("states.kicker")}</span>
        </div>
        <div class="section-head" style="margin-top: 20px;">
          <h2 data-i18n="states.title">{d("states.title")}</h2>
          <p class="section-sub" data-i18n="states.sub">{d("states.sub")}</p>
          <p class="section-sub" style="margin-top:0.5rem; color:var(--muted); font-size:0.9rem;">
            <em data-i18n="states.reviewNote">{d("states.reviewNote")}</em>
          </p>
        </div>
        <div class="featured-states" id="featuredStates"></div>
        <div class="table-card">
          <div class="table-tools">
            <label class="search-wrap">
              <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="M16 16l4.5 4.5"></path></svg>
              <input id="stateSearch" type="search" placeholder={d("states.search")} aria-label={d("states.search")} autocomplete="off" />
            </label>
            <div class="legend">
              <span class="chip chip-ok" data-i18n="states.legendOk">{d("states.legendOk")}</span>
              <span class="chip chip-mid" data-i18n="states.legendMid">{d("states.legendMid")}</span>
              <span class="chip chip-warn" data-i18n="states.legendWarn">{d("states.legendWarn")}</span>
            </div>
          </div>
          <div class="table-scroll">
            <table class="state-table">
              <thead>
                <tr>
                  <th data-i18n="states.colState">{d("states.colState")}</th>
                  <th data-i18n="states.colAcuity">{d("states.colAcuity")}</th>
                  <th data-i18n="states.colIfBelow">{d("states.colIfBelow")}</th>
                  <th data-i18n="states.colRenewal">{d("states.colRenewal")}</th>
                </tr>
              </thead>
              <tbody id="stateTableBody"></tbody>
            </table>
          </div>
          <p class="table-foot" data-i18n="states.foot">{d("states.foot")}</p>
        </div>
      </section>
    )}

    <section class="intro-section page-pad" id="how">
      <div class="section-label">
        <span class="label-dot"></span>
        <span data-i18n="how.kicker">{d("how.kicker")}</span>
        <span class="label-number">01 / 04</span>
      </div>
      <div class="intro-grid">
        <div class="intro-heading">
          <h2 data-i18n="how.title">{d("how.title")}</h2>
          <p data-i18n="how.sub">{d("how.sub")}</p>
          <a class="underlined-link" href={testHref}>
            <span>{d("nav.cta")}</span>
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
          </a>
        </div>
        <div class="steps-list">
          <div class="step-row">
            <span>01</span>
            <div>
              <h3 data-i18n="how.s1t">{d("how.s1t")}</h3>
              <p data-i18n="how.s1b">{d("how.s1b")}</p>
                <p data-i18n="calib.brightness" style="margin-top: 8px;">{d("calib.brightness")}</p>
            </div>
            <svg class="step-arrow ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
          </div>
          <div class="step-row">
            <span>02</span>
            <div>
              <h3 data-i18n="how.s2t">{d("how.s2t")}</h3>
              <p data-i18n="how.s2b">{d("how.s2b")}</p>
            </div>
            <svg class="step-arrow ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
          </div>
          <div class="step-row">
            <span>03</span>
            <div>
              <h3 data-i18n="how.s3t">{d("how.s3t")}</h3>
              <p data-i18n="how.s3b">{d("how.s3b")}</p>
            </div>
            <svg class="step-arrow ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
          </div>
          <div class="step-row">
            <span>04</span>
            <div>
              <h3 data-i18n="how.s4t">{d("how.s4t")}</h3>
              <p data-i18n="how.s4b">{d("how.s4b")}</p>
            </div>
            <svg class="step-arrow ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
          </div>
        </div>
      </div>
    </section>

    <div class="snellen-wrap page-pad" aria-hidden="true">
      <div class="snellen-divider">
        <span class="snellen-motif">
          <span class="m-1">E</span>
          <span class="m-2">F P</span>
          <span class="m-3">T O Z</span>
          <span class="m-4">L P E D</span>
        </span>
      </div>
    </div>

    <section class="checks-section page-pad" id="checks">
      <div class="section-label">
        <span class="label-dot"></span>
        <span data-i18n="checks.kicker">{d("checks.kicker")}</span>
        <span class="label-number">02 / 04</span>
      </div>
      <div class="checks-heading">
        <div>
          <h2 data-i18n={K("checks.title")}>{d(K("checks.title"))}</h2>
        </div>
        <p data-i18n="checks.sub">{d("checks.sub")}</p>
      </div>
      <div class="check-list" id="checkGrid">
        {checkList.map((c, idx) => {
          const num = String(idx + 1).padStart(2, "0");
          return (
            <button
              type="button"
              class="check-row"
              data-test={c.test}
              data-href={`${testHref}?mode=individual&check=${encodeURIComponent(c.test)}`}
              aria-label={`${d(`checks.${c.id}.name`)} — ${d("checks.open")}`}
            >
              <span class="check-index">{num}</span>
              <span class="check-name">{d(`checks.${c.id}.name`)}</span>
              <span class="check-description">{d(`checks.${c.id}.desc`)}</span>
              <span class="check-category">{c.tag}</span>
              <span class="check-arrow" aria-hidden="true">
                <svg class="ico" viewBox="0 0 24 24"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
              </span>
            </button>
          );
        })}
      </div>
      {!isUS && (
        <p class="checks-cdl-note" data-i18n="checks.cdlNote" style="margin-top: 1.25rem; font-size: 0.88rem; color: var(--text-2, #4A5658); font-style: italic;">
          {d("checks.cdlNote")}
        </p>
      )}
      <a class="button button-dark checks-button" href={testHref}>
        <span data-i18n="hero.cta1">{d("hero.cta1")}</span>
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
      </a>
    </section>

    <section class="refs-section page-pad" id="reference">
      <div class="section-label">
        <span class="label-dot"></span>
        <span data-i18n="refs.kicker">{d("refs.kicker")}</span>
      </div>
      <div class="refs-heading">
        <h2 data-i18n="refs.title">{d("refs.title")}</h2>
        <p data-i18n="refs.sub">{d("refs.sub")}</p>
      </div>
      <div class="ref-grid" id="refGrid">
        {REFS.map((r) => (
          <a class="ref-card" href={r.url} target="_blank" rel="noopener noreferrer">
            <span class="ref-badge" data-i18n="refs.learn">{d("refs.learn")}</span>
            <h3>{d("refs." + r.id + ".t")}</h3>
            <p>{d("refs." + r.id + ".b")}</p>
            <span class="ref-go">
              {new URL(r.url).hostname.replace(/^www\./, "")}
              <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
            </span>
          </a>
        ))}
      </div>
      <div class="ref-links">
        <div class="ref-col">
          <h3 data-i18n="refs.sources">{d("refs.sources")}</h3>
          <ul class="ref-list" id="sourceList">
            {SOURCES.map((s) => (
              <li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.name}</a></li>
            ))}
          </ul>
        </div>
        {isUS && (
          <div class="ref-col">
            <h3 data-i18n="refs.dmv">{d("refs.dmv")}</h3>
            <ul class="ref-list" id="dmvList">
              {DMV_LINKS.map((dmv) => (
                <li><a href={dmv.url} target="_blank" rel="noopener noreferrer"><b>{dmv.code}</b>{dmv.name}</a></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>

    <section class="faq-section page-pad" id="faq">
      <div class="section-label">
        <span class="label-dot"></span>
        <span data-i18n="faq.kicker">{d("faq.kicker")}</span>
        <span class="label-number">04 / 04</span>
      </div>
      <div class="faq-grid">
        <div>
          <h2 data-i18n="faq.title">{d("faq.title")}</h2>
          <p data-i18n="faq.lede">{d("faq.lede")}</p>
        </div>
        <div class="faq-list" id="faqList">
          {faqNums.map((n) => (
            <details class="faq-item">
              <summary>
                <span>{d(`faq.q${n}`)}</span>
              </summary>
              <div class="faq-body"><p>{d(`faq.a${n}`)}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    {meta.body && meta.body.length > 0 && (
      <section class="guide-section page-pad" id="guide">
        <div class="section-label">
          <span class="label-dot"></span>
          <span>{isUS ? "DMV Reference Guide" : d("nav.start")}</span>
        </div>
        <h2>{meta.articleTitle || (isUS ? "DMV Vision Guide" : d("nav.start"))}</h2>
        <article class="prose" style="max-width: 800px;">
          {meta.body.map((sec) => (
            <div style="margin-bottom: 28px;">
              <h3>{sec.h}</h3>
              <p>{sec.p}</p>
            </div>
          ))}
        </article>
      </section>
    )}

    </main>

  <SiteFooter locale={locale} page="home" variant={variant} />
</div>

<script>
  import "../scripts/app.ts";
</script>
