---
/**
 * Header + footer used by every page that is not the wizard home page.
 * Links are locale-aware (they point at the same page in the current locale)
 * and the language pills are real navigable URLs, which is what makes the
 * locales crawlable.
 */
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";

const { locale = "en", page = "home", customAlts } = Astro.props;
const SKIP_L: Record<string, string> = {
  en: "Skip to content",
  es: "Saltar al contenido",
  fr: "Aller au contenu",
  de: "Zum Inhalt springen",
  pt: "Pular para o conteúdo",
  it: "Salta al contenuto",
  ja: "本文へスキップ",
  ru: "Перейти к содержимому",
};
const skipLabel = SKIP_L[locale] || SKIP_L.en;
---

<a class="skip-link" href="#main">{skipLabel}</a>
<div class="grain" aria-hidden="true"></div>

<SiteHeader locale={locale} page={page} customAlts={customAlts} />

<main id="main">
  <slot />
</main>

<SiteFooter locale={locale} page={page} />

