---
/**
 * Header + footer used by every page that is not the wizard home page.
 * Links are locale-aware (they point at the same page in the current locale)
 * and the language pills are real navigable URLs, which is what makes the
 * locales crawlable.
 */
import { LOCALES, pathFor, SITE } from "../lib/site.ts";

const { locale = "en", page = "home", customAlts } = Astro.props;
const L = {
  en: {
    home: "Home", checks: "Checks", blog: "Blog", chart: "Eye Test Chart", us: "DMV Practice", states: "States", about: "About", contact: "Contact", cta: "Start free check",
    privacy: "Privacy", terms: "Terms", guides: "Guides", legal: "Legal", lang: "Language",
    skip: "Skip to content", theme: "Toggle dark mode",
    privacyNote: "No account · No uploads · Privacy-first analytics. Results stay in your browser.",
    disclaimer: "Practice screener only. Not an official test, not a medical examination, and no diagnosis or prescription.",
    rights: "Practice screener, free to use.",
  },
  es: {
    home: "Inicio", checks: "Pruebas", blog: "Blog", chart: "Eye Test Chart", us: "DMV Practice", states: "States", about: "Acerca de", contact: "Contacto", cta: "Empezar gratis",
    privacy: "Privacidad", terms: "Términos", guides: "Guías", legal: "Legal", lang: "Idioma",
    skip: "Saltar al contenido", theme: "Cambiar tema oscuro/claro",
    privacyNote: "Sin cuenta · Sin subidas · Analítica centrada en la privacidad. Los resultados se quedan en tu navegador.",
    disclaimer: "Evaluación de práctica únicamente. No es un examen oficial ni médico, y no ofrece diagnóstico ni receta.",
    rights: "Evaluador de práctica, uso gratuito.",
  },
  fr: {
    home: "Accueil", checks: "Tests", blog: "Blog", chart: "Eye Test Chart", us: "DMV Practice", states: "States", about: "À propos", contact: "Contact", cta: "Commencer gratuitement",
    privacy: "Confidentialité", terms: "Conditions", guides: "Guides", legal: "Mentions légales", lang: "Langue",
    skip: "Aller au contenu", theme: "Basculer le mode sombre",
    privacyNote: "Sans compte · Sans envoi · Analyse respectueuse de la vie privée. Les résultats restent dans votre navigateur.",
    disclaimer: "Outil d'entraînement uniquement. Ce n'est ni un examen officiel ni un acte médical, sans diagnostic ni ordonnance.",
    rights: "Outil d'entraînement, gratuit.",
  },
  de: {
    home: "Start", checks: "Tests", blog: "Blog", chart: "Eye Test Chart", us: "DMV Practice", states: "States", about: "Über", contact: "Kontakt", cta: "Kostenlos starten",
    privacy: "Datenschutz", terms: "Nutzung", guides: "Ratgeber", legal: "Rechtliches", lang: "Sprache",
    skip: "Zum Inhalt springen", theme: "Dunkelmodus umschalten",
    privacyNote: "Kein Konto · Keine Uploads · Datenschutzfreundliche Analysen. Ergebnisse bleiben in Ihrem Browser.",
    disclaimer: "Nur zur Übung. Kein offizieller Sehtest, keine ärztliche Untersuchung und keine Diagnose oder Verordnung.",
    rights: "Übungsprüfung, kostenlos.",
  },
  pt: {
    home: "Início", checks: "Testes", blog: "Blog", chart: "Eye Test Chart", us: "DMV Practice", states: "States", about: "Sobre", contact: "Contato", cta: "Começar grátis",
    privacy: "Privacidade", terms: "Termos", guides: "Guias", legal: "Legal", lang: "Idioma",
    skip: "Pular para o conteúdo", theme: "Alternar modo escuro",
    privacyNote: "Sem conta · Sem envios · Análise com foco na privacidade. Os resultados ficam no seu navegador.",
    disclaimer: "Apenas avaliação de prática. Não é um exame oficial nem médico, e não fornece diagnóstico ou receita.",
    rights: "Avaliação de prática, gratuita.",
  },
  it: {
    home: "Home", checks: "Test", blog: "Blog", chart: "Eye Test Chart", us: "DMV Practice", states: "States", about: "Chi siamo", contact: "Contatti", cta: "Inizia gratis",
    privacy: "Privacy", terms: "Termini", guides: "Guide", legal: "Note legali", lang: "Lingua",
    skip: "Salta al contenuto", theme: "Cambia tema chiaro/scuro",
    privacyNote: "Nessun account · Nessun upload · Analisi attenta alla privacy. I risultati restano nel tuo browser.",
    disclaimer: "Solo strumento di esercitazione. Non è un esame ufficiale né una visita medica, e non fornisce diagnosi o prescrizioni.",
    rights: "Screening gratuito, libero.",
  },
  ja: {
    home: "ホーム", checks: "検査一覧", blog: "ブログ", chart: "Eye Test Chart", us: "DMV Practice", states: "States", about: "概要", contact: "お問い合わせ", cta: "無料で開始",
    privacy: "プライバシー", terms: "利用規約", guides: "ガイド", legal: "法的情報", lang: "言語",
    skip: "本文へスキップ", theme: "ダークモード切替",
    privacyNote: "アカウント不要 · 送信なし · プライバシー最優先のアクセス解析。結果はブラウザ内にのみ保存されます。",
    disclaimer: "練習用スクリーニングです。公式試験や医療検査ではなく、診断や処方は行いません。",
    rights: "無料の練習用スクリーニング。",
  },
  ru: {
    home: "Главная", checks: "Тесты", blog: "Блог", chart: "Eye Test Chart", us: "DMV Practice", states: "States", about: "О проекте", contact: "Контакты", cta: "Начать бесплатно",
    privacy: "Конфиденциальность", terms: "Условия", guides: "Руководства", legal: "Право", lang: "Язык",
    skip: "Перейти к содержимому", theme: "Переключить темную тему",
    privacyNote: "Без аккаунта · Без загрузок · Аналитика с заботой о приватности. Результаты остаются в вашем браузере.",
    disclaimer: "Только для тренировки и ознакомления. Не является официальным осмотром, диагнозом или рецептом на очки.",
    rights: "Бесплатный тренажёр.",
  },
};
const t = L[locale] || L.en;
const home = pathFor(locale, "home");

const nav = [
  { label: t.home, href: home },
  { label: t.checks, href: "/checks/" },
  { label: t.blog, href: pathFor(locale, "blog") },
  { label: t.about, href: pathFor(locale, "about") },
  { label: t.contact, href: pathFor(locale, "contact") },
];
const isBlog = page === "blog" || page.startsWith("blog");
---

<a class="skip-link" href="#main">{t.skip}</a>
<div class="grain" aria-hidden="true"></div>

{page === "test" ? (
  <header class="site-header page-pad landing-style-header" id="siteHeader">
    <div class="header-inner">
      <a class="brand wordmark" href={home} aria-label="Online Vision Test home">
        <span class="brand-mark logo-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none">
            <path d="M2.5 16c3.4-6.2 8-9.3 13.5-9.3S26.1 9.8 29.5 16c-3.4 6.2-8 9.3-13.5 9.3S5.9 22.2 2.5 16Z" stroke="currentColor" stroke-width="2.1" stroke-linejoin="round"/>
            <circle cx="16" cy="16" r="4.6" fill="currentColor"/>
            <path d="M11.4 20.2 20.6 11.8" stroke="var(--brand-mark-slash, #fff)" stroke-width="1.5" stroke-linecap="round" opacity=".85"/>
          </svg>
        </span>
        <span class="brand-text">Online<span class="wordmark-light">Vision</span>Test<span class="wordmark-dot">.</span></span>
      </a>

      <nav class="header-nav nav-links" id="headerNav" aria-label="Main">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>

      <div class="header-tools">
        <label class="lang-wrap" title="Language">
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.7 2.6 15.3 0 18M12 3c-2.6 2.7-2.6 15.3 0 18"/></svg>
          <span class="lang-code" aria-hidden="true">{locale.toUpperCase()}</span>
          <select id="langSelect" aria-label="Language" data-current={locale}>
            <option value="en" selected={locale === "en"}>English</option>
            <option value="es" selected={locale === "es"}>Español</option>
            <option value="fr" selected={locale === "fr"}>Français</option>
            <option value="de" selected={locale === "de"}>Deutsch</option>
            <option value="pt" selected={locale === "pt"}>Português</option>
            <option value="it" selected={locale === "it"}>Italiano</option>
            <option value="ja" selected={locale === "ja"}>日本語</option>
            <option value="ru" selected={locale === "ru"}>Русский</option>
          </select>
        </label>
        <button class="icon-btn" id="themeBtn" type="button" aria-label={t.theme}>
          <svg class="ico ico-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.4M12 19.6V22M2 12h2.4M19.6 12H22M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M19.1 4.9l-1.7 1.7M6.6 17.4l-1.7 1.7"/></svg>
          <svg class="ico ico-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/></svg>
        </button>
        <button class="icon-btn menu-btn menu-toggle" id="menuBtn" type="button" aria-label="Menu" aria-expanded="false">
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 7h17M3.5 12h17M3.5 17h17"/></svg>
        </button>
      </div>
    </div>
    <div class="mobile-nav" id="mobileNav" hidden>
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </div>
  </header>
) : (
  <header class="site-header min-head" id="siteHeader">
    <div class="container header-inner">
      <a class="brand" href={home} aria-label="Online Vision Test">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none">
            <path d="M2.5 16c3.4-6.2 8-9.3 13.5-9.3S26.1 9.8 29.5 16c-3.4 6.2-8 9.3-13.5 9.3S5.9 22.2 2.5 16Z" stroke="currentColor" stroke-width="2.1" stroke-linejoin="round"/>
            <circle cx="16" cy="16" r="4.6" fill="currentColor"/>
            <path d="M11.4 20.2 20.6 11.8" stroke="var(--brand-mark-slash, #fff)" stroke-width="1.5" stroke-linecap="round" opacity=".85"/>
          </svg>
        </span>
        <span class="brand-text"><b>Online</b>Vision<span class="brand-tld">Test</span></span>
      </a>

      <nav class="min-nav" aria-label="Main">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>

      <div class="header-tools">
        {isBlog && (
          <label class="lang-wrap" title="Language">
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.7 2.6 15.3 0 18M12 3c-2.6 2.7-2.6 15.3 0 18"/></svg>
            <span class="lang-code" aria-hidden="true">{locale.toUpperCase()}</span>
            <select id="langSelect" aria-label="Language" data-current={locale}>
              {LOCALES.map((l) => {
                let targetUrl = pathFor(l, "blog");
                if (customAlts) {
                  const alt = customAlts.find(a => a.locale === l);
                  if (alt) targetUrl = alt.url.replace(SITE, "");
                  else targetUrl = pathFor(l, "blog");
                }
                const label = l === "en" ? "English" : l === "es" ? "Español" : l === "fr" ? "Français" : l === "de" ? "Deutsch" : l === "pt" ? "Português" : l === "it" ? "Italiano" : l === "ja" ? "日本語" : "Русский";
                return (
                  <option value={l} data-url={targetUrl} selected={locale === l}>{label}</option>
                );
              })}
            </select>
          </label>
        )}
        <button class="icon-btn" id="themeBtn" type="button" aria-label={t.theme}>
          <svg class="ico ico-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.4M12 19.6V22M2 12h2.4M19.6 12H22M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M19.1 4.9l-1.7 1.7M6.6 17.4l-1.7 1.7"/></svg>
          <svg class="ico ico-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/></svg>
        </button>
        <a class="btn btn-primary btn-sm header-cta" href={pathFor(locale, "test")}>{t.cta}</a>
      </div>
    </div>
    {!isBlog && (
      <div class="header-langs">
        <div class="container header-langs-inner">
          <ul class="lang-links header-pills" aria-label={t.lang}>
            {
              LOCALES.map((l) => {
                let targetUrl = pathFor(l, page);
                if (customAlts) {
                  const alt = customAlts.find(a => a.locale === l);
                  if (alt) targetUrl = alt.url.replace(SITE, "");
                  else return null;
                }
                return (
                  <li>
                    {l === locale ? (
                      <span class="pill-active" aria-current="true">{l.toUpperCase()}</span>
                    ) : (
                      <a href={targetUrl} hreflang={l} lang={l}>
                        {l.toUpperCase()}
                      </a>
                    )}
                  </li>
                );
              })
            }
          </ul>
        </div>
      </div>
    )}
  </header>
)}

<main id="main">
  <slot />
</main>

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="brand">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none">
            <path d="M2.5 16c3.4-6.2 8-9.3 13.5-9.3S26.1 9.8 29.5 16c-3.4 6.2-8 9.3-13.5 9.3S5.9 22.2 2.5 16Z" stroke="currentColor" stroke-width="2.1"/>
            <circle cx="16" cy="16" r="4.6" fill="currentColor"/>
          </svg>
        </span>
        <span class="brand-text"><b>Online</b>Vision<span class="brand-tld">Test</span></span>
      </div>
      <p>{t.privacyNote}</p>
      <ul class="lang-links" aria-label={t.lang}>
        {
          LOCALES.map((l) => {
            let targetUrl = pathFor(l, page);
            if (customAlts) {
              const alt = customAlts.find(a => a.locale === l);
              if (alt) targetUrl = alt.url.replace(SITE, "");
              else return null;
            }
            return (
              <li>
                {l === locale ? (
                  <span class="pill-active" aria-current="true">{l.toUpperCase()}</span>
                ) : (
                  <a href={targetUrl} hreflang={l} lang={l}>
                    {l.toUpperCase()}
                  </a>
                )}
              </li>
            );
          })
        }
      </ul>
    </div>
    <div class="footer-col">
      <h3>{t.guides}</h3>
      <ul>
        <li><a href={pathFor(locale, "test")}>{t.cta}</a></li>
        <li><a href="/eye-test-chart/">{t.chart}</a></li>
        <li><a href="/us/">{t.us}</a></li>
        <li><a href="/states/">{t.states}</a></li>
        <li><a href={pathFor(locale, "blog")}>{t.blog}</a></li>
        <li><a href={pathFor(locale, "about")}>{t.about}</a></li>
        <li><a href={pathFor(locale, "contact")}>{t.contact}</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h3>{t.legal}</h3>
      <ul>
        <li><a href={pathFor(locale, "privacy")}>{t.privacy}</a></li>
        <li><a href={pathFor(locale, "terms")}>{t.terms}</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <p class="disclaimer">{t.disclaimer}</p>
    <p class="copyright">© <span id="year">2026</span> OnlineVisionTest.org, operated by Perchange AI · {t.rights} · <a href="mailto:contact@onlinevisiontest.org">contact@onlinevisiontest.org</a></p>
  </div>
</footer>

<script is:inline>
  (function () {
    var b = document.getElementById("themeBtn");
    if (b && !b.dataset.boundTheme) {
      b.dataset.boundTheme = "1";
      b.addEventListener("click", function () {
        var next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("dmv-eye-test.theme", next);
        } catch (e) {}
      });
    }
    var ls = document.getElementById("langSelect");
    if (ls && !ls.dataset.boundLang) {
      ls.dataset.boundLang = "1";
      ls.addEventListener("change", function () {
        var opt = ls.options[ls.selectedIndex];
        if (opt && opt.dataset.url) {
          window.location.href = opt.dataset.url;
          return;
        }
        var newLang = ls.value;
        try {
          localStorage.setItem("dmv_eye_lang", newLang);
        } catch (e) {}
        var locales = ["es", "fr", "de", "pt", "it", "ja", "ru"];
        var pathSegments = window.location.pathname.split("/").filter(Boolean);
        if (pathSegments.length > 0 && pathSegments[0] === "us") {
          window.location.href = newLang === "en" ? "/us/" : "/" + newLang + "/";
          return;
        }
        if (pathSegments.length > 0 && locales.includes(pathSegments[0])) {
          if (newLang === "en") {
            pathSegments.shift();
          } else {
            pathSegments[0] = newLang;
          }
        } else {
          if (newLang !== "en") {
            pathSegments.unshift(newLang);
          }
        }
        var newPath = "/" + pathSegments.join("/");
        if (window.location.pathname.endsWith("/") && newPath !== "/") {
          newPath += "/";
        }
        if (window.location.search) newPath += window.location.search;
        if (window.location.hash) newPath += window.location.hash;
        window.location.href = newPath || "/";
      });
    }
    var m = document.getElementById("menuBtn");
    var mn = document.getElementById("mobileNav");
    if (m && mn && !m.dataset.boundMenu) {
      m.dataset.boundMenu = "1";
      m.addEventListener("click", function () {
        var isHidden = mn.hasAttribute("hidden");
        if (isHidden) {
          mn.removeAttribute("hidden");
          m.setAttribute("aria-expanded", "true");
        } else {
          mn.setAttribute("hidden", "");
          m.setAttribute("aria-expanded", "false");
        }
      });
    }
    var y = document.getElementById("year");
    if (y) y.textContent = String(new Date().getFullYear());
  })();
</script>
