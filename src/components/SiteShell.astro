const t = L[locale] || L.en;
const home = pathFor(locale, "home");

const nav = [
  { label: t.home, href: home },
  { label: t.checks, href: locale === "en" ? "/checks/" : `${home}#checks` },
  { label: t.blog, href: pathFor(locale, "blog") },
  { label: t.about, href: pathFor(locale, "about") },
  { label: t.contact, href: pathFor(locale, "contact") },
];
const isBlog = page === "blog" || page.startsWith("blog");
---

<a class="skip-link" href="#main">{t.skip}</a>
<div class="grain" aria-hidden="true"></div>

<SiteHeader locale={locale} page={page} customAlts={customAlts} />

<main id="main">
  <slot />
</main>

<SiteFooter locale={locale} page={page} />

