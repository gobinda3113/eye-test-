---
import { DICT } from "../scripts/dict.ts";

const { locale = "en" } = Astro.props;
const dict = DICT[locale] || DICT.en;
const d = (k: string) => (dict[k] != null ? dict[k] : DICT.en[k] != null ? DICT.en[k] : k);
---
<div class="test-page-wrap">
  <div class="test-banner" role="note" aria-label="Medical disclaimer">
    <div class="test-banner-inner">
      <svg class="ico banner-ico" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 9v4m0 4h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span data-i18n="modes.disclaimerBanner">{d("modes.disclaimerBanner")}</span>
    </div>
  </div>

  <div class="test-content">
    <div id="testEntryChoice" class="test-entry-choice">
      <div class="test-heading">
        <div class="section-label">
          <span class="label-dot"></span>
          <span data-i18n="modes.headingKicker">{d("modes.headingKicker")}</span>
        </div>
        <h1 class="test-title" data-i18n="modes.headingTitle">{d("modes.headingTitle")}</h1>
        <p class="test-sub" data-i18n="modes.headingSub">{d("modes.headingSub")}</p>
      </div>

      <div class="mode-cards-list">
        <!-- 01 Quick check -->
        <button
          type="button"
          class="mode-card"
          data-mode="quick"
          aria-label={`${d("modes.quickName")} — ${d("modes.quickDuration")}: ${d("modes.quickDesc")}`}
        >
          <span class="mode-accent-bar" aria-hidden="true"></span>
          <div class="mode-num-col">
            <span class="mode-num">01</span>
          </div>
          <div class="mode-info-col">
            <div class="mode-title-row">
              <h2 class="mode-title" data-i18n="modes.quickName">{d("modes.quickName")}</h2>
              <span class="mode-pill" data-i18n="modes.quickDuration">{d("modes.quickDuration")}</span>
            </div>
            <p class="mode-desc" data-i18n="modes.quickDesc">{d("modes.quickDesc")}</p>
          </div>
          <div class="mode-arrow-col">
            <span class="mode-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="ico" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M13 6l6 6-6 6"/>
              </svg>
            </span>
          </div>
        </button>

        <!-- 02 Full screening -->
        <button
          type="button"
          class="mode-card"
          data-mode="full"
          aria-label={`${d("modes.fullName")} — ${d("modes.fullDuration")}: ${d("modes.fullDesc")}`}
        >
          <span class="mode-accent-bar" aria-hidden="true"></span>
          <div class="mode-num-col">
            <span class="mode-num">02</span>
          </div>
          <div class="mode-info-col">
            <div class="mode-title-row">
              <h2 class="mode-title" data-i18n="modes.fullName">{d("modes.fullName")}</h2>
              <span class="mode-pill" data-i18n="modes.fullDuration">{d("modes.fullDuration")}</span>
            </div>
            <p class="mode-desc" data-i18n="modes.fullDesc">{d("modes.fullDesc")}</p>
          </div>
          <div class="mode-arrow-col">
            <span class="mode-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="ico" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M13 6l6 6-6 6"/>
              </svg>
            </span>
          </div>
        </button>

        <!-- 03 Individual test -->
        <button
          type="button"
          class="mode-card"
          data-mode="individual"
          aria-label={`${d("modes.indivName")} — ${d("modes.indivDuration")}: ${d("modes.indivDesc")}`}
        >
          <span class="mode-accent-bar" aria-hidden="true"></span>
          <div class="mode-num-col">
            <span class="mode-num">03</span>
          </div>
          <div class="mode-info-col">
            <div class="mode-title-row">
              <h2 class="mode-title" data-i18n="modes.indivName">{d("modes.indivName")}</h2>
              <span class="mode-pill" data-i18n="modes.indivDuration">{d("modes.indivDuration")}</span>
            </div>
            <p class="mode-desc" data-i18n="modes.indivDesc">{d("modes.indivDesc")}</p>
          </div>
          <div class="mode-arrow-col">
            <span class="mode-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="ico" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M13 6l6 6-6 6"/>
              </svg>
            </span>
          </div>
        </button>
      </div>
    </div>

    <!-- The actual test UI starts hidden -->
    <div class="lab" id="lab" style="display: none;">
      <div class="lab-bar">
        <div class="lab-bar-left">
          <span class="lab-dot" aria-hidden="true"></span>
          <span id="labStatus" data-i18n="lab.ready">{d("lab.ready")}</span>
        </div>
        <div class="lab-bar-right">
          <button class="btn btn-quiet btn-xs" id="labFullBtn" type="button" data-i18n="lab.focus">{d("lab.focus")}</button>
          <button class="btn btn-quiet btn-xs" id="labExitBtn" type="button" style="display:none;" data-i18n="lab.exit">{d("lab.exit")}</button>
          <button class="btn btn-quiet btn-xs" id="labResetBtn" type="button" data-i18n="lab.reset">{d("lab.reset")}</button>
        </div>
      </div>
      <div class="stepper-wrap" id="stepperWrap">
        <ol class="stepper" id="stepper"></ol>
      </div>
      <div class="lab-norm" id="labNorm" hidden></div>
      <div class="lab-stage" id="labStage"><p class="stage-sub" data-lab-fallback>{d("lab.ready")}</p></div>
      <div class="lab-foot" id="labFoot"></div>
      <noscript><p class="stage-sub">{d("lab.ready")}</p></noscript>
    </div>
  </div>
</div>

<style>
  .test-page-wrap {
    min-height: calc(100vh - var(--header-h, 68px));
    display: flex;
    flex-direction: column;
    background: var(--bg);
  }

  .test-banner {
    background: var(--surface-2);
    color: var(--text-2);
    border-bottom: 1px solid var(--border);
    padding: 10px 16px;
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .test-banner-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }

  .banner-ico {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    color: var(--primary);
  }

  .test-content {
    flex: 1;
    max-width: 860px;
    margin: 0 auto;
    width: 100%;
    padding: 3rem 1.25rem 4rem;
    box-sizing: border-box;
  }

  .test-heading {
    margin-bottom: 2.5rem;
    text-align: left;
  }

  .test-heading .section-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--primary);
    margin-bottom: 0.75rem;
  }

  .test-heading .label-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--primary);
  }

  .test-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--text);
    margin: 0 0 0.75rem;
  }

  .test-sub {
    font-size: 1.05rem;
    color: var(--text-2);
    line-height: 1.6;
    max-width: 640px;
    margin: 0;
  }

  .mode-cards-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .mode-card {
    position: relative;
    overflow: hidden;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.6rem 2rem;
    display: grid;
    grid-template-columns: 56px 1fr 44px;
    align-items: center;
    gap: 1.5rem;
    text-align: left;
    cursor: pointer;
    box-sizing: border-box;
    width: 100%;
    transition: transform 0.22s cubic-bezier(0.2, 0, 0, 1),
                box-shadow 0.22s ease,
                border-color 0.22s ease,
                filter 0.15s ease;
  }

  .mode-accent-bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 5px;
    background: var(--primary);
    opacity: 0;
    transform: scaleY(0.4);
    transition: opacity 0.22s ease, transform 0.22s cubic-bezier(0.2, 0, 0, 1);
    border-radius: 16px 0 0 16px;
  }

  .mode-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px -4px rgba(13, 122, 106, 0.14),
                0 4px 12px rgba(16, 20, 24, 0.05);
    border-color: var(--primary);
  }

  .mode-card:hover .mode-accent-bar {
    opacity: 1;
    transform: scaleY(1);
  }

  .mode-card:hover .mode-arrow {
    background: var(--primary);
    color: #FFFFFF;
    border-color: var(--primary);
    transform: translateX(3px);
  }

  .mode-card:active,
  .mode-card.is-active {
    transform: translateY(-1px) scale(0.995);
    filter: brightness(0.96);
  }

  .mode-num-col {
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .mode-num {
    font-family: var(--font-display);
    font-size: clamp(2rem, 2.5vw, 2.5rem);
    font-weight: 700;
    line-height: 1;
    color: var(--primary);
    letter-spacing: -0.03em;
  }

  .mode-info-col {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .mode-title-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .mode-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--text);
    margin: 0;
    line-height: 1.25;
  }

  .mode-pill {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--surface-2);
    color: var(--primary);
    border: 1px solid var(--border-soft);
    white-space: nowrap;
  }

  .mode-desc {
    font-size: 0.95rem;
    color: var(--text-2);
    line-height: 1.45;
    margin: 0;
  }

  .mode-arrow-col {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .mode-arrow {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--text);
    flex-shrink: 0;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .mode-arrow svg {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 640px) {
    .test-content {
      padding: 2rem 1rem 3rem;
    }

    .mode-card {
      grid-template-columns: 1fr auto;
      gap: 1rem;
      padding: 1.25rem 1.4rem;
    }

    .mode-num-col {
      grid-column: 1 / 2;
    }

    .mode-arrow-col {
      grid-column: 2 / 3;
      align-self: flex-start;
    }

    .mode-info-col {
      grid-column: 1 / 3;
    }
  }
</style>

<script>
  import "../scripts/app.ts";
</script>
