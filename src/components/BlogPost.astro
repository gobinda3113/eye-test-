---
import { DICT } from "../scripts/dict.ts";
import { pathFor, urlFor } from "../lib/site.ts";
import { POSTS } from "../data/blog.ts";

const RELATED_LABEL = {
  en: "Related reading",
  es: "Lecturas relacionadas",
  fr: "À lire aussi",
  de: "Weiterlesen",
  pt: "Leia também",
  it: "Leggi anche",
  ja: "関連記事",
  ru: "Читайте также",
};

const { locale = "en", post } = Astro.props;
const dict = DICT[locale] || DICT.en;
const d = (k) => (dict[k] != null ? dict[k] : DICT.en[k] != null ? DICT.en[k] : k);

const home = pathFor(locale, "home");
const testHref = pathFor(locale, "test");
const aboutHref = pathFor(locale, "about");
const blogHome = pathFor(locale, "blog");
const BLOG_LABEL = { en: "Blog", es: "Blog", fr: "Blog", de: "Blog", pt: "Blog", it: "Blog", ja: "ブログ", ru: "Блог" }[locale] || "Blog";

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Online Vision Test", item: home },
    { "@type": "ListItem", position: 2, name: BLOG_LABEL, item: urlFor(locale, "blog") },
    { "@type": "ListItem", position: 3, name: post.title[locale] || post.title.en, item: urlFor(locale, "blog") + post.slug + "/" },
  ],
};

const META_L = {
  en: { by: "Written by Gobinda Adhikari · Online Vision Test", rev: "Last reviewed: November 2026", src: "Sources: official DMV agencies, ISO 8596 & optometry references" },
  es: { by: "Escrito por Gobinda Adhikari · Online Vision Test", rev: "Última revisión: Noviembre 2026", src: "Fuentes: agencias oficiales, ISO 8596 y optometría" },
  fr: { by: "Écrit par Gobinda Adhikari · Online Vision Test", rev: "Dernière révision : Novembre 2026", src: "Sources : agences officielles, ISO 8596 et optométrie" },
  de: { by: "Verfasst von Gobinda Adhikari · Online Vision Test", rev: "Zuletzt überprüft: November 2026", src: "Quellen: offizielle Behörden, ISO 8596 & Optometrie" },
  pt: { by: "Escrito por Gobinda Adhikari · Online Vision Test", rev: "Última revisão: Novembro 2026", src: "Fontes: agências oficiais, ISO 8596 e optometria" },
  it: { by: "Scritto da Gobinda Adhikari · Online Vision Test", rev: "Ultima revisione: Novembre 2026", src: "Fonti: enti ufficiali, ISO 8596 e optometria" },
  ja: { by: "執筆: Gobinda Adhikari · Online Vision Test", rev: "最終確認: 2026年11月", src: "情報源: 公的機関・ISO 8596・検眼資料" },
  ru: { by: "Автор: Gobinda Adhikari · Online Vision Test", rev: "Последнее обновление: Ноябрь 2026", src: "Источники: официальные ведомства, ISO 8596 и оптометрия" },
};
const m = META_L[locale] || META_L.en;

// Start after the current post and wrap, so related links rotate instead of
// every post pointing at the same three entries.
const postIndex = POSTS.findIndex((p) => p.slug === post.slug);
const rotatedPosts =
  postIndex >= 0 ? [...POSTS.slice(postIndex + 1), ...POSTS.slice(0, postIndex)] : POSTS;

const related = rotatedPosts.filter((p) => {
  if (p.slug === post.slug) return false;
  const supported = p.locales || (p.englishOnly ? ["en"] : Object.keys(p.title || {}));
  return supported.includes(locale);
}).slice(0, 3);
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />

<section class="section">
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href={home}>Online Vision Test</a></li>
        <li><a href={blogHome}>{BLOG_LABEL}</a></li>
        <li aria-current="page">{post.title[locale] || post.title.en}</li>
      </ol>
    </nav>

    <div class="simple-hero">
      <div class="eyebrow">{d("blog.postEyebrow")}</div>
      <h1>{post.title[locale] || post.title.en}</h1>
      <p>{post.excerpt[locale] || post.excerpt.en}</p>
      <div style="margin-top: 1.5rem; font-size: 0.85rem; color: var(--muted); border-top: 1px solid var(--border); padding-top: 1rem; display: flex; flex-wrap: wrap; gap: 6px 18px;">
        <div><a href={aboutHref} style="color: inherit; font-weight: 600; text-decoration: underline;">{m.by}</a></div>
        <span aria-hidden="true" style="opacity: 0.4;">·</span>
        <div>{m.rev}</div>
        <span aria-hidden="true" style="opacity: 0.4;">·</span>
        <div><a href={`${home}#reference`} style="color: inherit; text-decoration: underline;">{m.src}</a></div>
      </div>
    </div>

    <div class="doc-layout">
      <div class="content-body prose">
        <article set:html={post.content[locale] || post.content.en} />

        <div class="snellen-divider" aria-hidden="true" style="margin: 48px 0 36px;">
          <span class="snellen-motif">
            <span class="m-1">E</span>
            <span class="m-2">F P</span>
            <span class="m-3">T O Z</span>
            <span class="m-4">L P E D</span>
          </span>
        </div>

        <div class="dark-ink-panel" style="margin-top: 36px;">
          <h3 style="margin-top: 0; font-size: clamp(1.6rem, 2.5vw, 2.2rem);">{locale === "en" ? "Ready to test your vision?" : d("nav.start")}</h3>
          <p style="margin-bottom: 24px;">{locale === "en" ? "Calibrate your screen and practice the vision checks in 10 minutes." : d("hero.trust3")}</p>
          <a class="btn btn-primary btn-lg" href={testHref}>{d("nav.cta")}</a>
        </div>

        {related.length > 0 && (
          <aside class="related-posts" aria-labelledby="related-heading">
            <h2 id="related-heading">{RELATED_LABEL[locale] || RELATED_LABEL.en}</h2>
            <ul>
              {related.map((p) => (
                <li>
                  <a href={pathFor(locale, "blog") + p.slug + "/"}>
                    {p.title[locale] || p.title.en}
                  </a>
                  <p>{p.excerpt[locale] || p.excerpt.en}</p>
                </li>
              ))}
            </ul>
          </aside>
        )}
      </div>

      <aside class="doc-aside" aria-label={d("nav.start")}>
        <div class="doc-aside-card">
          <h3>{locale === "en" ? "Calibrated Vision Screener" : d("nav.start")}</h3>
          <p>{d("hero.trust3")}</p>
          <ul class="doc-aside-list">
            <li><span>ISO/IEC 7810</span><strong>85.6 mm</strong></li>
            <li><span>{locale === "en" ? "Benchmark" : "20/40"}</span><strong>20/40</strong></li>
          </ul>
          <a class="btn btn-primary" style="width: 100%; justify-content: center;" href={pathFor(locale, "test")}>{d("nav.cta")}</a>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .related-posts {
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }

  .related-posts h2 {
    font-size: 20px;
    margin: 0 0 18px;
  }

  .related-posts ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }

  .related-posts a {
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
  }

  .related-posts a:hover {
    text-decoration: underline;
  }

  .related-posts p {
    margin: 4px 0 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--muted);
  }
</style>
