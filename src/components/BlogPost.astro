---
import { DICT } from "../scripts/i18n.ts";
import { pathFor, urlFor } from "../lib/site.ts";

const { locale = "en", post } = Astro.props;
const dict = DICT[locale] || DICT.en;
const d = (k) => (dict[k] != null ? dict[k] : DICT.en[k] != null ? DICT.en[k] : k);

const home = pathFor(locale, "home");
const blogHome = pathFor(locale, "blog");
const BLOG_LABEL = { en: "Blog", es: "Blog", fr: "Blog", de: "Blog", pt: "Blog", it: "Blog", ja: "ブログ", ru: "Блог" }[locale] || "Blog";

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Online Vision Test", item: home },
    { "@type": "ListItem", position: 2, name: BLOG_LABEL, item: urlFor(locale, "blog") },
    { "@type": "ListItem", position: 3, name: post.title[locale] || post.title.en, item: urlFor(locale, "blog") + post.slug + "/" },
  ],
};


const META_L = {
  en: { by: "Written by Online Vision Test", rev: "Last reviewed: September 2026", src: "Sources: official DMV agencies, optometry references" },
  es: { by: "Escrito por Online Vision Test", rev: "Última revisión: Septiembre 2026", src: "Fuentes: agencias oficiales, referencias de optometría" },
  fr: { by: "Écrit par Online Vision Test", rev: "Dernière révision : Septembre 2026", src: "Sources : agences officielles, références en optométrie" },
  de: { by: "Geschrieben von Online Vision Test", rev: "Zuletzt überprüft: September 2026", src: "Quellen: offizielle Agenturen, Optometrie-Referenzen" },
  pt: { by: "Escrito por Online Vision Test", rev: "Última revisão: Setembro 2026", src: "Fontes: agências oficiais, referências de optometria" },
  it: { by: "Scritto da Online Vision Test", rev: "Ultima revisione: Settembre 2026", src: "Fonti: agenzie ufficiali, riferimenti di optometria" },
  ja: { by: "執筆: Online Vision Test", rev: "最終確認: 2026年9月", src: "情報源: 公式機関、検眼資料" },
  ru: { by: "Написано Online Vision Test", rev: "Последнее обновление: Сентябрь 2026", src: "Источники: официальные агентства, оптометрические справочники" },
};
const m = META_L[locale] || META_L.en;
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />

<section class="section">
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href={home}>Online Vision Test</a></li>
        <li><a href={blogHome}>{BLOG_LABEL}</a></li>
        <li aria-current="page">{post.title[locale] || post.title.en}</li>
      </ol>
    </nav>

    <div class="simple-hero">
      <h1>{post.title[locale] || post.title.en}</h1>
      <p>{post.excerpt[locale] || post.excerpt.en}</p>
      <div style="margin-top: 1.5rem; font-size: 0.9rem; color: var(--muted); border-top: 1px solid var(--border); padding-top: 1rem;">
        <div><strong>{m.by}</strong></div>
        <div>{m.rev}</div>
        <div>{m.src}</div>
      </div>
    </div>

    <div class="content-body" style="max-width: 800px; margin: 0 auto;">
      <article set:html={post.content[locale] || post.content.en} />

      <div style="margin-top: 60px; padding: 40px; background: var(--bg-elev); border-radius: var(--r-lg); text-align: center; border: 1px solid var(--border);">
        <h3 style="margin-top: 0;">{locale === "en" ? "Ready to test your vision?" : d("nav.start")}</h3>
        <p style="color: var(--muted); margin-bottom: 24px;">{locale === "en" ? "Calibrate your screen and practice the vision checks in 10 minutes." : d("hero.trust3")}</p>
        <a class="btn btn-primary" href={home}>{d("nav.cta")}</a>
      </div>
    </div>
  </div>
</section>
